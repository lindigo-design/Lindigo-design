---
import '../styles/global.css';
import { locales, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Шлях сторінки без мовного префікса, напр. "/" */
  path?: string;
}

const { locale, title, description, path = '/' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(localePath(locale, path), site);
// Тимчасова копія на GitHub Pages не має потрапляти в пошук
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
// Файли з public/ — разом із base сайту (/Lindigo-design на тимчасовій копії)
const asset = (file: string) => `${(import.meta.env.BASE_URL ?? '/').replace(/\/+$/, '')}/${file}`;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('fr', path), site)} />
    <!-- Favicon: знак логотипа (Figma «Logo + icon»). SVG міняє колір під тему браузера; PNG — для Safari й iOS -->
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta name="theme-color" content="#150b2e" />
    <meta name="color-scheme" content="dark light" />
    <!-- Тема до першого малювання, щоб сторінка не блимала. Перше відвідування — темна (системну тему не читаємо). -->
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('lindigo-theme');
        } catch (e) {}
        var theme = saved === 'light' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('js');
        if (theme === 'light') {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#f8eedd');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
