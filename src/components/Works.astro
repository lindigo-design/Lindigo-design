---
/**
 * Блок «03 Вибрані роботи» (Figma «Головна · Варіант 2», темна й світла тема).
 * Слайдер кейсів: картка на склі (обкладинка, назва, мітки, задача й що з'ясували до дизайну, кнопка),
 * під нею вкладки з назвами напрямів і навігація (SliderNav).
 * Правило блоку: по одній найновішій роботі з кожного напряму (Сайт, Інтернет-магазин, Брендинг, Застосунок).
 * Роботи в ui[locale].works.items ідуть від найновішої; для кожного напряму береться перша.
 * Напрям без робіт не показується, лічильник рахує тільки видимі вкладки.
 * Фон блоку — векторні плями, що «дихають» (Breath.astro).
 */
import { Image } from 'astro:assets';
import Breath from './Breath.astro';
import bgLight from '../assets/backgrounds/works-light.jpg';
import bgDark from '../assets/backgrounds/dark-horizontal.jpg';
import Button from './Button.astro';
import SliderNav from './SliderNav.astro';
import allDark from '../assets/works/all-dark.svg';
import allLight from '../assets/works/all-light.svg';
import datatixx from '../assets/works/datatixx.jpg';
import { keepLastWords, localePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].works;
const covers: Record<string, ImageMetadata> = { datatixx };
// Порядок вкладок (Figma): Сайт, Інтернет-магазин, Брендинг, Застосунок
const directionOrder = ['site', 'shop', 'branding', 'app'];
const items = directionOrder.flatMap((d) => t.items.find((item) => item.direction === d) ?? []);
---

<section class="works" aria-labelledby="works-title" data-works>
  <Breath variant="works" lightImage={bgLight} darkImage={bgDark} />

  <header class="works__head">
    <div class="works__heading">
      <p class="works__eyebrow">{t.eyebrow}</p>
      <h2 class="works__title" id="works-title">{t.title}</h2>
    </div>
    <a class="works__all" href={localePath(locale, '/realisations/')}>
      {t.all}
      <span class="works__all-icon" aria-hidden="true">
        <img src={allDark.src} width="36" height="36" alt="" data-theme-only="dark" />
        <img src={allLight.src} width="36" height="36" alt="" data-theme-only="light" />
      </span>
    </a>
  </header>

  <div class="works__slider">
  <div class="works__slides">
    {
      items.map((item, i) => (
        <article
          class="case"
          id={`case-${item.slug}`}
          role="tabpanel"
          aria-labelledby={`case-tab-${item.slug}`}
          hidden={i !== 0}
          data-slide
        >
          <div class="case__cover">
            <Image src={covers[item.slug]} alt="" widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 584px" loading="lazy" />
          </div>
          <div class="case__about">
            <div class="case__head">
              <h3 class="case__name">{item.name}</h3>
              <ul class="case__tags">
                {item.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
            <dl class="case__desc">
              <div>
                <dt>{t.taskLabel}</dt>
                <dd>{keepLastWords(item.task)}</dd>
              </div>
              <div>
                <dt>{t.foundLabel}</dt>
                <dd>{keepLastWords(item.found)}</dd>
              </div>
            </dl>
            <Button href={localePath(locale, `/realisations/${item.slug}/`)} variant="secondary">
              {t.view}
              <span class="visually-hidden">: {item.name}</span>
            </Button>
          </div>
        </article>
      ))
    }
  </div>

  <div class="works__controls">
    <div class="works__tabs" role="tablist" aria-label={t.title}>
      {
        items.map((item, i) => (
          <button
            class="works__tab"
            type="button"
            role="tab"
            id={`case-tab-${item.slug}`}
            aria-controls={`case-${item.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab
          >
            {item.tab}
          </button>
        ))
      }
    </div>
    <SliderNav id="works" prevLabel={t.prev} nextLabel={t.next} disabledNote={t.navDisabled} total={items.length} />
  </div>
  </div>
</section>

<style>
  .works {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
    overflow: hidden;
  }


  /* ---------- Заголовок і «Усі роботи» ---------- */
  .works__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-24);
  }

  .works__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .works__eyebrow {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .works__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 56px;
    line-height: 68px;
  }

  .works__all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    font-weight: 600;
    font-size: 16px;
    line-height: 22px;
    text-decoration: none;
    border-radius: var(--radius-full);
  }

  .works__all-icon img {
    display: block;
    transition: transform var(--dur-btn) var(--ease-out-in);
  }

  @media (hover: hover) {
    .works__all:hover .works__all-icon img {
      transform: rotate(45deg);
    }
  }
  .works__all:focus-visible .works__all-icon img {
    transform: rotate(45deg);
  }

  /* ---------- Слайдер: картка, під нею вкладки й стрілки ---------- */
  .works__slider {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  /* ---------- Картка кейса ---------- */
  .case {
    display: flex;
    align-items: stretch;
    gap: var(--space-48);
    padding: var(--space-32) var(--space-48) var(--space-32) var(--space-32);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-32);
    background: var(--card-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .case[hidden] {
    display: none;
  }

  .case.is-entering {
    animation: case-in 0.5s var(--ease-out-in);
  }

  @keyframes case-in {
    from {
      opacity: 0;
    }
  }

  .case__cover {
    /* Обкладинка на всю висоту тексту праворуч, не нижча за макетні 480 */
    flex: 0 0 584px;
    position: relative;
    min-height: 480px;
    overflow: hidden;
    border-radius: var(--radius-24);
  }

  .case__cover :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .case__about {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-40);
    align-self: center;
    flex: 1 1 0;
    min-width: 0;
  }

  .case__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .case__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 56px;
    line-height: 68px;
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case__tags li {
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--fg);
    border-radius: var(--radius-20);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
  }

  .case__desc {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    margin: 0;
  }

  .case__desc div {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .case__desc dt {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--label-muted);
  }

  .case__desc dd {
    margin: 0;
    font-weight: 400;
    font-size: 20px;
    line-height: 30px;
    color: var(--fg);
  }

  /* ---------- Вкладки й навігація ---------- */
  .works__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24) var(--space-40);
  }

  .works__tabs {
    display: flex;
    gap: var(--space-40);
    min-width: 0;
  }

  /* Вкладка — назва напряму, Heading/H4 (Figma). Активна: Orchid / Indigo 800, решта — Grey supplement / Muted Deep */
  .works__tab {
    padding: var(--space-4) 0;
    border: 0;
    background: none;
    color: var(--tab-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 34px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .works__tab:hover {
    color: var(--fg);
  }

  .works__tab[aria-selected='true'] {
    color: var(--tab-active);
  }

  /* ---------- Вужчий комп'ютер і планшет ---------- */
  @media (max-width: 1100px) {
    .case {
      gap: var(--space-32);
      padding: var(--space-32);
    }
    .case__cover {
      flex: 0 0 46%;
      min-height: 0;
      aspect-ratio: 584 / 480;
      align-self: center;
    }
    .case__about {
      gap: var(--space-32);
    }
    .case__name {
      font-size: 40px;
      line-height: 48px;
    }
    .case__desc dd {
      font-size: 18px;
      line-height: 28px;
    }
  }

  /* Картка в стовпчик; вкладки гортаються вбік */
  @media (max-width: 760px) {
    .case {
      flex-direction: column;
      align-items: stretch;
    }
    .case__cover {
      flex: none;
      width: 100%;
    }
    .works__controls {
      flex-wrap: wrap;
    }
    .works__tabs {
      overflow-x: auto;
      scrollbar-width: none;
      flex: 1 1 100%;
    }
  }

  /* Телефон */
  @media (max-width: 640px) {
    .works {
      gap: var(--space-32);
      padding: var(--space-96) var(--space-20);
    }
    .works__title {
      font-size: 32px;
      line-height: 40px;
    }
    .case {
      gap: var(--space-24);
      padding: var(--space-16) var(--space-16) var(--space-24);
      border-radius: var(--radius-24);
    }
    .case__cover {
      border-radius: var(--radius-16);
    }
    .case__about {
      gap: var(--space-24);
      padding-inline: var(--space-8);
    }
    .case__name {
      font-size: 32px;
      line-height: 40px;
    }
    .case__desc dd {
      font-size: 16px;
      line-height: 24px;
    }
    .works__tabs {
      gap: var(--space-24);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case.is-entering {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-works]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const current = root.querySelector<HTMLElement>('[data-slider-current]');
    let index = 0;

    function show(next: number, focusTab = false) {
      const n = (next + slides.length) % slides.length;
      if (n === index) return;
      slides[index].hidden = true;
      tabs[index].setAttribute('aria-selected', 'false');
      tabs[index].tabIndex = -1;
      index = n;
      const slide = slides[index];
      slide.hidden = false;
      slide.classList.remove('is-entering');
      void slide.offsetWidth;
      slide.classList.add('is-entering');
      tabs[index].setAttribute('aria-selected', 'true');
      tabs[index].tabIndex = 0;
      tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (focusTab) tabs[index].focus();
      if (current) current.textContent = String(index + 1).padStart(2, '0');
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));
    root.querySelector('[data-slider-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-slider-next]')?.addEventListener('click', () => show(index + 1));

    // Клавіатура у вкладках: стрілки, Home, End
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const e = event as KeyboardEvent;
      const keys: Record<string, number> = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: slides.length - 1 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      show(keys[e.key], true);
    });
  });
</script>
