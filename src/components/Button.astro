---
/**
 * Кнопка: посилання (є href) або кнопка форми (href немає). Дві форми (Figma, «Кнопки: стани»):
 *  - primary   — залита, зі стрілкою в колі. Наведення: коло від курсора відкриває градієнт
 *                (темна тема Orchid → Orange, світла Indigo 600 → Orchid Deep). Коло зі стрілкою
 *                зсувається вправо на 6 px, стрілка всередині повертається вправо, текст стоїть.
 *                Текст і коло завжди стоять поруч по центру кнопки, між ними 12 px — і у вузькій,
 *                і в кнопці на всю ширину. Відступи до країв однакові: 32 px. Градієнт лежить на всю кнопку, коло лише відкриває його,
 *                тому в кінці наведення кнопка точно така, як у Figma.
 *  - secondary — з обводкою. Наведення: обводка 2 px стає градієнтною, колір біжить по контуру.
 * Розмір md — 56 px (перший екран), sm — 48 px (шапка).
 *
 * Вимкнена (disabled): тільки aria-disabled="true", НЕ атрибут disabled — кнопка лишається у фокусі,
 * і читач екрана озвучує пояснення з describedBy (id елемента з текстом причини). Клік нічого не робить,
 * наведення й натискання не працюють, контур фокусу видимий. Вигляду вимкненої кнопки в Figma немає —
 * прозорість --disabled-opacity (пропозиція).
 */
import arrowOnGold from '../assets/hero/arrow-cta-dark.svg';
import arrowOnIndigo from '../assets/hero/arrow-cta-light.svg';

interface Props {
  /** Є — посилання <a>; немає — <button> */
  href?: string;
  /** Тип <button> (без href) */
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  /** Вимкнена: aria-disabled="true" */
  disabled?: boolean;
  /** id елемента, що пояснює, чому кнопка вимкнена (aria-describedby) */
  describedBy?: string;
  class?: string;
}

const { href, type = 'button', variant = 'primary', size = 'md', disabled = false, describedBy, class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
// Вимкнене посилання втрачає href (нікуди не веде), але лишається у фокусі завдяки tabindex
const attrs = href
  ? disabled
    ? { role: 'link', tabindex: 0 }
    : { href }
  : { type };
---

<Tag
  {...attrs}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'ring-hover': variant === 'secondary' }, className]}
  aria-disabled={disabled ? 'true' : undefined}
  aria-describedby={describedBy}
  data-btn
>
  {variant === 'primary' && <span class="btn__fill" aria-hidden="true" />}
  <span class="btn__label"><slot /></span>
  {
    variant === 'primary' && (
      <span class="btn__arrow" aria-hidden="true">
        <img src={arrowOnGold.src} width="18" height="18" alt="" data-theme-only="dark" />
        <img src={arrowOnIndigo.src} width="18" height="18" alt="" data-theme-only="light" />
      </span>
    )
  }
</Tag>

<style>
  .btn {
    --x: 50%;
    --y: 50%;
    /* Радіус кола. 100 % у circle() — більше за відстань від центру до кута */
    --r: 100%;

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    height: 56px;
    padding-inline: var(--space-32);
    border-radius: var(--radius-full);
    font: inherit;
    font-family: var(--font-body);
    font-weight: var(--text-title-16--font-weight);
    font-size: var(--text-title-16);
    line-height: var(--text-title-16--line-height);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s ease;
  }

  /* <button> без рамки браузера; обводка другої кнопки — з .ring-hover */
  button.btn--primary {
    border: 0;
  }

  .btn--sm {
    height: 48px;
    padding-inline: var(--space-24);
    font-size: 0.875rem; /* 14px */
    /* Інтервал .btn у відсотках рахується від розміру, тож для 14 px свій відсоток — щоб лишилось 22 px */
    line-height: 157.1429%; /* 22px */
  }

  .btn__label {
    position: relative;
  }

  /* ---------- Головна ---------- */
  /* Відступи симетричні (32 px з обох боків): текст, 12 px і коло — один блок по центру.
     Ширина росте за вмістом; коло ніколи не ближче 24 px до краю, навіть із зсувом 6 px при наведенні. */
  .btn--primary {
    overflow: hidden;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
  }

  .btn__fill {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--btn-primary-hover);
    clip-path: circle(0 at var(--x) var(--y));
    transition:
      clip-path var(--dur-btn) var(--ease-out-in),
      filter 0.2s ease;
    pointer-events: none;
  }

  .btn__arrow {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }

  .btn__arrow,
  .btn__arrow img {
    transition: transform var(--dur-btn) var(--ease-out-in);
  }

  /* ---------- Друга: кільце при наведенні — спільний клас .ring-hover (global.css) ---------- */
  /* Друга кнопка: обводка кольору акценту й заливка 20 % того ж кольору (як «Записатися на дзвінок» у шапці),
     щоб її не плутали з пігулками-тегами (рішення Яни 26.11.2026) */
  .btn--secondary {
    border-color: var(--accent-text);
    background-color: color-mix(in srgb, var(--accent-text) 20%, transparent);
    transition:
      border-color var(--dur-btn) var(--ease-out-in),
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  /* ---------- Стани ---------- */
  @media (hover: hover) {
    .btn--primary:not([aria-disabled='true']):hover .btn__fill {
      clip-path: circle(var(--r) at var(--x) var(--y));
    }
    .btn--primary:not([aria-disabled='true']):hover .btn__arrow {
      transform: translateX(6px);
    }
    .btn--primary:not([aria-disabled='true']):hover .btn__arrow img {
      transform: rotate(45deg);
    }
  }

  /* Клавіатура: та сама заливка, коло росте з центру */
  .btn--primary:not([aria-disabled='true']):focus-visible .btn__fill {
    clip-path: circle(var(--r) at var(--x) var(--y));
  }
  .btn--primary:not([aria-disabled='true']):focus-visible .btn__arrow {
    transform: translateX(6px);
  }
  .btn--primary:not([aria-disabled='true']):focus-visible .btn__arrow img {
    transform: rotate(45deg);
  }

  /* Натискання (і короткий спалах на телефоні, клас ставить скрипт) */
  .btn:not([aria-disabled='true']):active,
  .btn:not([aria-disabled='true']).is-pressed {
    transform: scale(0.98);
  }
  .btn--primary:not([aria-disabled='true']):active .btn__fill,
  .btn--primary:not([aria-disabled='true']).is-pressed .btn__fill {
    clip-path: circle(var(--r) at var(--x) var(--y));
    filter: brightness(0.9);
  }

  /* Вимкнена: прозора, без заливки й руху стрілки; контур фокусу — загальний :focus-visible */
  .btn--primary[aria-disabled='true'] {
    opacity: var(--disabled-opacity);
    cursor: not-allowed;
  }

  /* Вимкнений рух: колір міняється одразу, без кола й без повороту стрілки */
  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn__fill,
    .btn__arrow,
    .btn__arrow img {
      transition: none !important;
      animation: none !important;
    }
    .btn--primary:not([aria-disabled='true']):hover .btn__arrow,
    .btn--primary:not([aria-disabled='true']):focus-visible .btn__arrow,
    .btn--primary:not([aria-disabled='true']):hover .btn__arrow img,
    .btn--primary:not([aria-disabled='true']):focus-visible .btn__arrow img {
      transform: none;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('[data-btn]');

  function placeFill(btn: HTMLElement, clientX: number, clientY: number) {
    const r = btn.getBoundingClientRect();
    const x = clientX - r.left;
    const y = clientY - r.top;
    // Радіус кола: відстань до найдальшого кута, щоб залити всю кнопку
    const radius = Math.hypot(Math.max(x, r.width - x), Math.max(y, r.height - y));
    btn.style.setProperty('--x', `${x}px`);
    btn.style.setProperty('--y', `${y}px`);
    btn.style.setProperty('--r', `${Math.ceil(radius) + 1}px`);
  }

  buttons.forEach((btn) => {
    // Вимкнена кнопка: клік і Enter нічого не роблять (і не відправляють форму)
    btn.addEventListener('click', (e) => {
      if (btn.getAttribute('aria-disabled') === 'true') {
        e.preventDefault();
        e.stopImmediatePropagation();
      }
    });
    btn.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') placeFill(btn, e.clientX, e.clientY);
    });
    // Коло стискається туди, де курсор залишив кнопку
    btn.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') placeFill(btn, e.clientX, e.clientY);
    });
    btn.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || btn.getAttribute('aria-disabled') === 'true') return;
      placeFill(btn, e.clientX, e.clientY);
      btn.classList.add('is-pressed');
    });
    const release = () => window.setTimeout(() => btn.classList.remove('is-pressed'), 350);
    btn.addEventListener('pointerup', release);
    btn.addEventListener('pointercancel', release);
    // Фокус з клавіатури — коло з центру
    btn.addEventListener('focus', () => {
      btn.style.removeProperty('--x');
      btn.style.removeProperty('--y');
      btn.style.removeProperty('--r');
    });
  });
</script>
