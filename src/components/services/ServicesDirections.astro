---
/**
 * «Напрями» (Figma 413:5980, «05 Напрями (sticky)»): п'ять напрямів один під одним.
 * Ліворуч (480 px) номер, назва (H3) і кнопка «Детальніше» — прилипають під шапкою, поки прокручується права колонка:
 * опис (Body/L), фото проєкту з підписом і «Що входить» (назва Title/18 + опис Body/M, лінії між пунктами).
 * Посилання «Детальніше» — на сторінку напряму (поки що там заглушка, крім UI/UX).
 * Кожен напрям — на картці, як картки напрямів на головній (Directions.astro): --card-bg, рамка, радіус 32 (рішення Яни, 25.11.2026).
 */
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import ServicesHead from './ServicesHead.astro';
import { directionAnchors, directionImages, directionKeys, directionPath } from '../../data/services';
import { keepLastWords, localePath, type Locale } from '../../i18n/ui';
import type { ServicesText } from '../../i18n/services';

interface Props {
  locale: Locale;
  content: ServicesText['directions'];
}

const { locale, content: t } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="sv-dirs" id="directions" aria-labelledby="sv-dirs-title">
  <ServicesHead eyebrow={t.eyebrow} title={t.title} lead={t.lead} id="sv-dirs-title" />

  <ol class="sv-dirs__list">
    {
      directionKeys.map((key, i) => {
        const d = t.items[key];
        return (
          <li class="sv-dir" id={directionAnchors[key]}>
            <div class="sv-dir__side">
              <p class="sv-dir__num" aria-hidden="true">{pad(i + 1)}</p>
              <h3 class="sv-dir__title">{d.title}</h3>
              <Button href={localePath(locale, directionPath(key))} variant="secondary">{d.more}</Button>
            </div>
            <div class="sv-dir__main">
              <p class="sv-dir__text">{keepLastWords(d.text)}</p>
              <figure class="sv-dir__figure">
                <Image class="sv-dir__img" src={directionImages[key]} alt="" widths={[792, 1584]} sizes="(max-width: 1100px) 100vw, 52vw" loading="lazy" />
                <figcaption class="sv-dir__caption">{d.caption}</figcaption>
              </figure>
              <div class="sv-dir__includes">
                <p class="sv-dir__label">{t.includes}</p>
                <dl class="sv-dir__points">
                  {d.points.map((p) => (
                    <div class="sv-dir__point">
                      <dt>{p.title}</dt>
                      <dd>{keepLastWords(p.text)}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .sv-dirs {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
  }

  .sv-dirs__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sv-dir {
    /* якір з картки ситуації: зупинка нижче шапки */
    scroll-margin-top: var(--space-96);
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-80);
    padding: var(--space-48);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-32);
    background: var(--card-bg);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  /* Ліва колонка прилипає під шапкою (шапка 82 + 16 згори + запас) */
  .sv-dir__side {
    position: sticky;
    top: var(--space-120);
    flex-shrink: 0;
    width: min(480px, 36%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
  }

  .sv-dir__num {
    font-family: var(--font-mono);
    font-weight: var(--text-label-m--font-weight);
    font-size: var(--text-label-m);
    line-height: var(--text-label-m--line-height);
    letter-spacing: var(--text-label-m--letter-spacing);
    color: var(--accent-text);
  }

  .sv-dir__title {
    font-family: var(--font-display);
    font-weight: var(--text-h3--font-weight);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
  }

  .sv-dir__main {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .sv-dir__text {
    font-size: var(--text-body-l);
    line-height: var(--text-body-l--line-height);
  }

  .sv-dir__figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: 0;
  }

  .sv-dir__figure :global(.sv-dir__img) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--aspect-direction-photo);
    object-fit: cover;
    border-radius: var(--radius-16);
  }

  .sv-dir__caption {
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
    color: var(--text-muted);
  }

  .sv-dir__includes {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .sv-dir__label {
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .sv-dir__points {
    margin: 0;
  }

  .sv-dir__point {
    display: flex;
    gap: var(--space-24);
    padding-block: var(--space-20);
    border-top: 1px solid var(--rule);
  }

  .sv-dir__point dt {
    flex-shrink: 0;
    width: 240px;
    font-weight: var(--text-title-18--font-weight);
    font-size: var(--text-title-18);
    line-height: var(--text-title-18--line-height);
  }

  .sv-dir__point dd {
    flex: 1 1 0;
    margin: 0;
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
    color: var(--text-muted);
  }

  /* Планшет і телефон: одна колонка, без прилипання */
  @media (max-width: 1100px) {
    .sv-dir {
      flex-direction: column;
      gap: var(--space-32);
      padding: var(--space-32);
    }
    .sv-dir__side {
      position: static;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .sv-dirs {
      gap: var(--space-40);
      padding-block: var(--space-56);
    }
    .sv-dirs__list {
      gap: var(--space-16);
    }
    .sv-dir {
      gap: var(--space-24);
      padding: var(--space-24);
      border-radius: var(--radius-24);
    }
    .sv-dir__title {
      font-size: var(--text-h2-mobile);
      line-height: var(--text-h2-mobile--line-height);
    }
    .sv-dir__text {
      font-size: var(--text-body-m);
      line-height: var(--text-body-m--line-height);
    }
    .sv-dir__point {
      flex-direction: column;
      gap: var(--space-4);
      padding-block: var(--space-16);
    }
    .sv-dir__point dt {
      width: auto;
    }
    /* кнопки всіх напрямів однієї довжини — на ширину картки; довгий текст переноситься, а не вилазить за край */
    .sv-dir__side :global(.btn) {
      align-self: stretch;
      height: auto;
      min-height: var(--space-56);
      padding-block: var(--space-12);
      white-space: normal;
      text-align: center;
    }
    /* картки накладаються одна на одну, як на головній (клас is-stacked і top ставить скрипт) */
    .sv-dirs__list.is-stacked .sv-dir {
      position: sticky;
      background: linear-gradient(var(--card-bg), var(--card-bg)), var(--section-bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* накрита картка — ледь фіолетова й темніша (--cover від 0 до 1 задає скрипт) */
  .sv-dir::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: color-mix(in srgb, var(--section-bg) 85%, var(--accent-text));
    opacity: calc(var(--cover, 0) * 0.8);
    pointer-events: none;
  }
</style>

<script>
  import { stackCards } from '../../scripts/stack-cards';

  /* Телефон: напрями накладаються один на одного (на комп'ютері прилипає ліва колонка, тож стосу там немає) */
  document.querySelectorAll<HTMLElement>('.sv-dirs__list').forEach((list) => {
    stackCards(list, Array.from(list.querySelectorAll<HTMLElement>(':scope > .sv-dir')), {
      cover: '(max-width: 640px)',
      phone: '(max-width: 640px)',
    });
  });
</script>
