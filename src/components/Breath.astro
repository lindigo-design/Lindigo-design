---
/**
 * Векторний фон із кольорових плям, що «дихають» (замість растрових картинок, які пікселізувались
 * на великих екранах). Плями — радіальні градієнти: чіткі на будь-якій ширині й нічого не важать.
 * Кольори й місця плям зняті з фонів Figma для кожного блоку й теми.
 *
 * Дихання: поки блок на екрані, плями повільно й хаотично пливуть і змінюють розмір
 * (у кожної свій шлях і своя тривалість, тож рух не повторюється синхронно).
 * Поза екраном анімація на паузі; з «зменшити рух» у системі плями стоять.
 *
 * Пляма за мишкою: ще одна пляма м'яко пливе за курсором, поки він над блоком
 * (з невеликим запізненням, як у рідині). На дотикових екранах і з «зменшити рух» її немає.
 *
 * Розмітку ставимо першою дитиною секції з position: relative; isolation: isolate.
 */
interface Props {
  variant: 'works' | 'reviews' | 'cta' | 'directions' | 'process' | 'faq';
}

const { variant } = Astro.props;

/** «Як ми працюємо» і FAQ: фон — розмите фото рідини, тож тут ще чотири кулі в його кольорах */
const liquid = variant === 'process' || variant === 'faq';

/**
 * Пляма за мишкою — компонент Figma «Підсвітка миші · градієнт» (564 × 564, шість еліпсів).
 * Поле плями 640 одиниць: макет 564 + запас 38 з кожного боку, бо еліпси виходять за рамку.
 * Для кожного еліпса: центр і півосі в одиницях поля, колір (RGB) і непрозорість у центрі.
 * Спад непрозорості в кожному еліпсі як у Figma: 100 / 85 / 55 / 27 / 8 / 0 % на 0 / 25 / 50 / 70 / 88 / 100 %.
 * Порядок: верхній шар першим (у CSS перший фон — зверху).
 */
const glowLayers = [
  { name: 'золото ліворуч', cx: 189, cy: 328.5, rx: 145, ry: 195, rgb: '178 137 2', a: 0.4 },
  { name: 'темне тепло', cx: 318, cy: 458, rx: 200, ry: 140, rgb: '138 47 16', a: 0.4 },
  { name: 'тепло знизу', cx: 328, cy: 438, rx: 260, ry: 190, rgb: '242 99 42', a: 0.36 },
  { name: 'орхідея', cx: 398, cy: 308, rx: 160, ry: 150, rgb: '165 52 196', a: 0.28 },
  { name: 'слива', cx: 388, cy: 328, rx: 250, ry: 230, rgb: '122 58 143', a: 0.6 },
  { name: 'індиго згори', cx: 288, cy: 238, rx: 260, ry: 230, rgb: '33 19 74', a: 0.95 },
];
const falloff: [number, number][] = [[0, 1], [25, 0.85], [50, 0.55], [70, 0.27], [88, 0.08], [100, 0]];
const pct = (v: number) => `${+((v / 640) * 100).toFixed(2)}%`;
const glowBg = glowLayers
  .map(({ cx, cy, rx, ry, rgb, a }) => {
    const stops = falloff.map(([p, k]) => `rgb(${rgb} / calc(var(--a) * ${+(a * k).toFixed(3)})) ${p}%`).join(', ');
    return `radial-gradient(${pct(rx)} ${pct(ry)} at ${pct(cx)} ${pct(cy)}, ${stops})`;
  })
  .join(', ');
---

<div class:list={['breath', `breath--${variant}`]} aria-hidden="true" data-breathe>
  <span class="breath__blob breath__blob--1"></span>
  <span class="breath__blob breath__blob--2"></span>
  <span class="breath__blob breath__blob--3"></span>
  <span class="breath__blob breath__blob--4"></span>
  {
    liquid &&
      [5, 6, 7, 8].map((n) => <span class={`breath__blob breath__blob--${n}`} />)
  }
  <span class="breath__cursor" data-breathe-cursor style={`background: ${glowBg}`}></span>
</div>

<style>
  .breath {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--breath-base);
  }

  .breath__blob {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c, transparent), transparent);
    translate: -50% -50%;
    will-change: transform;
    animation: var(--anim) var(--dur) ease-in-out infinite alternate;
    animation-play-state: paused;
  }

  .breath.is-breathing .breath__blob {
    animation-play-state: running;
  }

  .breath__blob--1 { --anim: breath-a; --dur: 19s; }
  .breath__blob--2 { --anim: breath-b; --dur: 23s; }
  .breath__blob--3 { --anim: breath-c; --dur: 27s; }
  .breath__blob--4 { --anim: breath-b; --dur: 31s; animation-direction: alternate-reverse; }

  /* «Як ми працюємо» і FAQ: кулі різного розміру з розмитого фото рідини.
     Кожна безперервно обходить шестикутник або восьмикутник (вершини — на колі ~16–20 % власного
     розміру). Перша куля йде за годинниковою стрілкою, решта — проти. Від'ємна затримка
     ставить кожну в іншу точку шляху, щоб вони не рухались хором. */
  :is(.breath--process, .breath--faq) .breath__blob {
    animation-name: var(--anim);
    animation-duration: var(--dur);
    animation-timing-function: linear;
    animation-direction: normal;
    animation-delay: var(--delay, 0s);
  }
  :is(.breath--process, .breath--faq) .breath__blob--1 { --anim: hex-cw; --dur: 16s; }
  :is(.breath--process, .breath--faq) .breath__blob--2 { --anim: oct-ccw; --dur: 18s; --delay: -5s; }
  :is(.breath--process, .breath--faq) .breath__blob--3 { --anim: hex-ccw; --dur: 20s; --delay: -11s; }
  :is(.breath--process, .breath--faq) .breath__blob--4 { --anim: oct-ccw; --dur: 22s; --delay: -3s; }
  :is(.breath--process, .breath--faq) .breath__blob--5 { --anim: oct-ccw; --dur: 26s; --delay: -14s; }
  :is(.breath--process, .breath--faq) .breath__blob--6 { --anim: hex-ccw; --dur: 15s; --delay: -7s; }
  :is(.breath--process, .breath--faq) .breath__blob--7 { --anim: oct-ccw; --dur: 19s; --delay: -9s; }
  :is(.breath--process, .breath--faq) .breath__blob--8 { --anim: hex-ccw; --dur: 17s; --delay: -2s; }

  /* Шестикутник, радіус 20 %: за стрілкою (на екрані y росте вниз, тож кут збільшується) */
  @keyframes hex-cw {
    0%, 100% { transform: translate(20%, 0) scale(1); }
    16.667% { transform: translate(10%, 17.3%) scale(1.06); }
    33.333% { transform: translate(-10%, 17.3%) scale(0.96); }
    50% { transform: translate(-20%, 0) scale(1.04); }
    66.667% { transform: translate(-10%, -17.3%) scale(0.95); }
    83.333% { transform: translate(10%, -17.3%) scale(1.05); }
  }
  /* Той самий шестикутник проти стрілки */
  @keyframes hex-ccw {
    0%, 100% { transform: translate(20%, 0) scale(1); }
    16.667% { transform: translate(10%, -17.3%) scale(1.05); }
    33.333% { transform: translate(-10%, -17.3%) scale(0.95); }
    50% { transform: translate(-20%, 0) scale(1.04); }
    66.667% { transform: translate(-10%, 17.3%) scale(0.96); }
    83.333% { transform: translate(10%, 17.3%) scale(1.06); }
  }
  /* Восьмикутник, радіус 16 %, проти стрілки */
  @keyframes oct-ccw {
    0%, 100% { transform: translate(16%, 0) scale(1); }
    12.5% { transform: translate(11.3%, -11.3%) scale(1.04); }
    25% { transform: translate(0, -16%) scale(1.07); }
    37.5% { transform: translate(-11.3%, -11.3%) scale(1.02); }
    50% { transform: translate(-16%, 0) scale(0.96); }
    62.5% { transform: translate(-11.3%, 11.3%) scale(0.94); }
    75% { transform: translate(0, 16%) scale(0.98); }
    87.5% { transform: translate(11.3%, 11.3%) scale(1.02); }
  }

  /* Три різні шляхи: зсув у межах ~12 % власного розміру, легке стискання й розширення */
  @keyframes breath-a {
    0% { transform: translate(0, 0) scale(1); }
    30% { transform: translate(9%, -6%) scale(1.08); }
    65% { transform: translate(-6%, 5%) scale(0.94); }
    100% { transform: translate(5%, 8%) scale(1.05); }
  }
  @keyframes breath-b {
    0% { transform: translate(0, 0) scale(1.04); }
    40% { transform: translate(-10%, -4%) scale(0.95); }
    75% { transform: translate(6%, -9%) scale(1.1); }
    100% { transform: translate(-4%, 6%) scale(1); }
  }
  @keyframes breath-c {
    0% { transform: translate(0, 0) scale(0.96); }
    35% { transform: translate(7%, 9%) scale(1.06); }
    70% { transform: translate(-9%, 3%) scale(1); }
    100% { transform: translate(3%, -7%) scale(1.09); }
  }

  /* Пляма за мишкою: компонент Figma «Підсвітка миші · градієнт» — шість м'яких еліпсів
     (індиго згори, слива й орхідея в центрі, тепло знизу, золото ліворуч); фон задано в розмітці.
     Поле 640 одиниць ≈ 42vw (на 1512 — як макет 564 px), центр — у точці курсора; рух веде скрипт. */
  .breath__cursor {
    --size: clamp(420px, 42vw, 760px);
    --a: 1; /* загальна сила кольорів; у світлій темі менша */
    position: absolute;
    left: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    opacity: 0;
    transition: opacity 0.8s ease;
    will-change: transform, opacity;
  }

  .breath.is-pointer .breath__cursor {
    opacity: 1;
  }

  /* На бежевому кольори насиченіші на око — трохи стримуємо */
  :global(:root[data-theme='light']) .breath__cursor {
    --a: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .breath__blob,
    :is(.breath--process, .breath--faq) .breath__blob {
      animation: none;
    }
    .breath__cursor {
      display: none;
    }
  }

  /* ---------- 03 Вибрані роботи ---------- */
  .breath--works {
    --breath-base: var(--night);
  }
  .breath--works .breath__blob--1 { --x: 35%; --y: 105%; --w: 75%; --h: 65%; --c: rgba(82, 48, 201, 0.38); }
  .breath--works .breath__blob--2 { --x: 62%; --y: 100%; --w: 50%; --h: 45%; --c: rgba(242, 99, 42, 0.16); }
  .breath--works .breath__blob--3 { --x: 92%; --y: 70%; --w: 38%; --h: 55%; --c: rgba(165, 52, 196, 0.2); }

  :global(:root[data-theme='light']) .breath--works {
    --breath-base: var(--beige-50);
  }
  :global(:root[data-theme='light']) .breath--works .breath__blob--1 { --x: 4%; --y: 95%; --w: 52%; --h: 70%; --c: rgba(165, 52, 196, 0.42); }
  :global(:root[data-theme='light']) .breath--works .breath__blob--2 { --x: 48%; --y: 108%; --w: 60%; --h: 42%; --c: rgba(242, 99, 42, 0.15); }
  :global(:root[data-theme='light']) .breath--works .breath__blob--3 { --x: 96%; --y: 100%; --w: 36%; --h: 38%; --c: rgba(221, 163, 247, 0.28); }

  /* ---------- 06 Відгуки ---------- */
  .breath--reviews {
    --breath-base: var(--night);
  }
  .breath--reviews .breath__blob--1 { --x: 40%; --y: 110%; --w: 75%; --h: 60%; --c: rgba(124, 82, 201, 0.6); }
  .breath--reviews .breath__blob--2 { --x: 66%; --y: 95%; --w: 46%; --h: 42%; --c: rgba(242, 99, 42, 0.2); }
  .breath--reviews .breath__blob--3 { --x: 93%; --y: 100%; --w: 36%; --h: 48%; --c: rgba(165, 52, 196, 0.32); }

  :global(:root[data-theme='light']) .breath--reviews {
    --breath-base: var(--beige-50);
  }
  :global(:root[data-theme='light']) .breath--reviews .breath__blob--1 { --x: 8%; --y: 98%; --w: 55%; --h: 72%; --c: rgba(165, 52, 196, 0.48); }
  :global(:root[data-theme='light']) .breath--reviews .breath__blob--2 { --x: 52%; --y: 106%; --w: 64%; --h: 52%; --c: rgba(242, 99, 42, 0.3); }
  :global(:root[data-theme='light']) .breath--reviews .breath__blob--3 { --x: 92%; --y: 102%; --w: 38%; --h: 40%; --c: rgba(221, 163, 247, 0.32); }

  /* ---------- 09 Заклик до дії (панель) ---------- */
  .breath--cta {
    --breath-base: #24143a;
  }
  .breath--cta .breath__blob--1 { --x: 40%; --y: 100%; --w: 75%; --h: 110%; --c: rgba(98, 70, 170, 0.65); }
  .breath--cta .breath__blob--2 { --x: 68%; --y: 78%; --w: 48%; --h: 95%; --c: rgba(176, 82, 92, 0.42); }
  .breath--cta .breath__blob--3 { --x: 8%; --y: 0%; --w: 55%; --h: 80%; --c: rgba(21, 11, 46, 0.55); }

  :global(:root[data-theme='light']) .breath--cta {
    --breath-base: #fbf4e7;
  }
  :global(:root[data-theme='light']) .breath--cta .breath__blob--1 { --x: 0%; --y: 80%; --w: 70%; --h: 160%; --c: rgba(124, 86, 164, 0.95); }
  :global(:root[data-theme='light']) .breath--cta .breath__blob--2 { --x: 66%; --y: 105%; --w: 56%; --h: 110%; --c: rgba(252, 150, 155, 0.95); }
  :global(:root[data-theme='light']) .breath--cta .breath__blob--3 { --x: 100%; --y: 40%; --w: 38%; --h: 120%; --c: rgba(212, 180, 225, 0.75); }
  /* ---------- 02 Напрями: світіння внизу блоку ---------- */
  .breath--directions { --breath-base: var(--night); }
  .breath--directions .breath__blob--1 { --x: 45%; --y: 95%; --w: 75%; --h: 26%; --c: rgba(82, 48, 201, 0.45); }
  .breath--directions .breath__blob--2 { --x: 22%; --y: 88%; --w: 42%; --h: 18%; --c: rgba(150, 60, 170, 0.3); }
  .breath--directions .breath__blob--3 { --x: 62%; --y: 98%; --w: 40%; --h: 14%; --c: rgba(242, 99, 42, 0.12); }
  .breath--directions .breath__blob--4 { --x: 95%; --y: 3%; --w: 36%; --h: 14%; --c: rgba(82, 48, 201, 0.12); }

  :global(:root[data-theme='light']) .breath--directions { --breath-base: var(--beige-50); }
  :global(:root[data-theme='light']) .breath--directions .breath__blob--1 { --x: 5%; --y: 90%; --w: 48%; --h: 24%; --c: rgba(165, 52, 196, 0.48); }
  :global(:root[data-theme='light']) .breath--directions .breath__blob--2 { --x: 55%; --y: 97%; --w: 58%; --h: 16%; --c: rgba(252, 150, 140, 0.6); }
  :global(:root[data-theme='light']) .breath--directions .breath__blob--3 { --x: 95%; --y: 88%; --w: 32%; --h: 16%; --c: rgba(221, 163, 247, 0.38); }
  :global(:root[data-theme='light']) .breath--directions .breath__blob--4 { --x: 96%; --y: 2%; --w: 30%; --h: 10%; --c: rgba(221, 163, 247, 0.25); }

  /* ---------- 04 Як ми працюємо: плями з Figma (місця з макета 1512 × 1344) ---------- */
  .breath--process { --breath-base: var(--night); }
  .breath--process .breath__blob--1 { --x: 75%; --y: 27%; --w: 43%; --h: 48%; --c: rgba(110, 60, 200, 0.5); }
  .breath--process .breath__blob--2 { --x: 76%; --y: 40%; --w: 28%; --h: 30%; --c: rgba(200, 70, 40, 0.32); }
  .breath--process .breath__blob--3 { --x: 23%; --y: 61%; --w: 40%; --h: 45%; --c: rgba(150, 60, 170, 0.45); }
  .breath--process .breath__blob--4 { --x: 11%; --y: 42%; --w: 26%; --h: 30%; --c: rgba(190, 50, 70, 0.32); }

  :global(:root[data-theme='light']) .breath--process { --breath-base: var(--beige-50); }
  :global(:root[data-theme='light']) .breath--process .breath__blob--1 { --x: 75%; --y: 27%; --w: 43%; --h: 48%; --c: rgba(190, 120, 230, 0.55); }
  :global(:root[data-theme='light']) .breath--process .breath__blob--2 { --x: 76%; --y: 40%; --w: 28%; --h: 30%; --c: rgba(240, 110, 150, 0.45); }
  :global(:root[data-theme='light']) .breath--process .breath__blob--3 { --x: 23%; --y: 61%; --w: 40%; --h: 45%; --c: rgba(200, 90, 190, 0.5); }
  :global(:root[data-theme='light']) .breath--process .breath__blob--4 { --x: 11%; --y: 41%; --w: 26%; --h: 30%; --c: rgba(240, 120, 150, 0.45); }

  /* Кольори фото рідини (однакові для «Як ми працюємо» і FAQ): глибоке індиго згори праворуч,
     рожева орхідея в центрі праворуч, помаранч знизу, золото в правому нижньому куті */
  :is(.breath--process, .breath--faq) .breath__blob--5 { --x: 88%; --y: 12%; --w: 48%; --h: 42%; --c: rgba(40, 28, 120, 0.6); }
  :is(.breath--process, .breath--faq) .breath__blob--6 { --x: 84%; --y: 56%; --w: 24%; --h: 26%; --c: rgba(214, 120, 226, 0.34); }
  :is(.breath--process, .breath--faq) .breath__blob--7 { --x: 70%; --y: 86%; --w: 32%; --h: 30%; --c: rgba(232, 102, 36, 0.32); }
  :is(.breath--process, .breath--faq) .breath__blob--8 { --x: 96%; --y: 96%; --w: 26%; --h: 28%; --c: rgba(255, 186, 60, 0.36); }

  :global(:root[data-theme='light']) :is(.breath--process, .breath--faq) .breath__blob--5 { --c: rgba(130, 110, 230, 0.32); }
  :global(:root[data-theme='light']) :is(.breath--process, .breath--faq) .breath__blob--6 { --c: rgba(236, 150, 226, 0.4); }
  :global(:root[data-theme='light']) :is(.breath--process, .breath--faq) .breath__blob--7 { --c: rgba(250, 140, 80, 0.32); }
  :global(:root[data-theme='light']) :is(.breath--process, .breath--faq) .breath__blob--8 { --c: rgba(255, 196, 80, 0.42); }

  /* ---------- 08 FAQ: ті самі плями в інших місцях (макет 1512 × 1123) ---------- */
  .breath--faq { --breath-base: var(--night); }
  .breath--faq .breath__blob--1 { --x: 74%; --y: 29%; --w: 43%; --h: 58%; --c: rgba(110, 60, 200, 0.5); }
  .breath--faq .breath__blob--2 { --x: 75%; --y: 44%; --w: 28%; --h: 36%; --c: rgba(200, 70, 40, 0.3); }
  .breath--faq .breath__blob--3 { --x: 22%; --y: 65%; --w: 40%; --h: 54%; --c: rgba(150, 60, 170, 0.45); }
  .breath--faq .breath__blob--4 { --x: 12%; --y: 52%; --w: 26%; --h: 36%; --c: rgba(190, 50, 70, 0.32); }

  :global(:root[data-theme='light']) .breath--faq { --breath-base: var(--beige-50); }
  :global(:root[data-theme='light']) .breath--faq .breath__blob--1 { --x: 74%; --y: 29%; --w: 43%; --h: 58%; --c: rgba(190, 120, 230, 0.5); }
  :global(:root[data-theme='light']) .breath--faq .breath__blob--2 { --x: 75%; --y: 44%; --w: 28%; --h: 36%; --c: rgba(240, 110, 150, 0.42); }
  :global(:root[data-theme='light']) .breath--faq .breath__blob--3 { --x: 22%; --y: 65%; --w: 40%; --h: 54%; --c: rgba(200, 90, 190, 0.48); }
  :global(:root[data-theme='light']) .breath--faq .breath__blob--4 { --x: 12%; --y: 52%; --w: 26%; --h: 36%; --c: rgba(240, 120, 150, 0.42); }
</style>

<script>
  // Дихання лише поки блок на екрані
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.target.classList.toggle('is-breathing', e.isIntersecting)),
    { rootMargin: '100px 0px' },
  );
  document.querySelectorAll('[data-breathe]').forEach((el) => observer.observe(el));

  // Пляма за мишкою: лише для миші й без «зменшити рух»
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-breathe]').forEach((layer) => {
    const blob = layer.querySelector<HTMLElement>('[data-breathe-cursor]');
    const section = layer.parentElement;
    if (!blob || !section) return;

    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, placed = false;

    const tick = () => {
      // м'яке наздоганяння курсора (≈ 8 % відстані за кадр)
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      blob.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
    };

    section.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !finePointer.matches || reduceMotion.matches) return;
      const r = layer.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      if (!placed) {
        // перша поява — одразу під курсором, без перельоту з кута
        x = tx; y = ty; placed = true;
        blob.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      }
      layer.classList.add('is-pointer');
      if (!raf) raf = requestAnimationFrame(tick);
    });

    section.addEventListener('pointerleave', () => {
      layer.classList.remove('is-pointer');
      placed = false;
    });
  });
</script>
