---
/**
 * Навігація слайдера: стрілки в колі 48 × 48 і лічильник «01 / 04» між ними (Figma, «Вибрані роботи»).
 * Один компонент для «Робіт» і «Відгуків» (план, розділ 10: «Навігація слайдера»).
 * Стрілки — SVG з Figma (коло й стрілка, своя пара на тему). Наведення — те саме кільце .ring-hover.
 * Логіку перемикання веде блок, у якому стоїть навігація: кнопки мають data-slider-prev / data-slider-next.
 * Один слайд — стрілки вимкнені через aria-disabled (лишаються у фокусі), причину озвучує disabledNote
 * (aria-describedby на прихований текст).
 */
import prevDark from '../assets/works/prev-dark.svg';
import prevLight from '../assets/works/prev-light.svg';
import nextDark from '../assets/works/next-dark.svg';
import nextLight from '../assets/works/next-light.svg';

interface Props {
  /** Унікальний префікс id на сторінці (works, reviews) */
  id: string;
  prevLabel: string;
  nextLabel: string;
  /** Чому стрілки вимкнені (коли слайд один) */
  disabledNote: string;
  total: number;
}

const { id, prevLabel, nextLabel, disabledNote, total } = Astro.props;
const off = total < 2;
const noteId = `${id}-nav-note`;
const state = off ? { 'aria-disabled': 'true', 'aria-describedby': noteId } : {};
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="slider-nav">
  <button class="slider-nav__btn ring-hover" type="button" aria-label={prevLabel} data-slider-prev {...state}>
    <img src={prevDark.src} width="48" height="48" alt="" data-theme-only="dark" />
    <img src={prevLight.src} width="48" height="48" alt="" data-theme-only="light" />
  </button>
  <p class="slider-nav__count">
    <span data-slider-current>01</span> / <span>{pad(total)}</span>
  </p>
  <button class="slider-nav__btn ring-hover" type="button" aria-label={nextLabel} data-slider-next {...state}>
    <img src={nextDark.src} width="48" height="48" alt="" data-theme-only="dark" />
    <img src={nextLight.src} width="48" height="48" alt="" data-theme-only="light" />
  </button>
  {off && <p class="visually-hidden" id={noteId}>{disabledNote}</p>}
</div>

<style>
  .slider-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Коло вже намальоване в SVG; власна обводка .ring-hover прозора, кільце з'являється при наведенні */
  .slider-nav__btn {
    display: block;
    width: 48px;
    height: 48px;
    padding: 0;
    border-color: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .slider-nav__btn img {
    display: block;
  }

  /* Вимкнені стрілки: прозорість і без кільця — спільне правило .ring-hover[aria-disabled] (global.css) */

  .slider-nav__count {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
</style>
