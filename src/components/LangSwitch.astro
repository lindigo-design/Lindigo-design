---
/**
 * Мови рядком «FR EN UK» (меню бургера, футер). Поточна підкреслена лінією 2 px (Figma, меню відкрите).
 * У шапці замість нього випадаюче меню LangMenu.astro; посилання будуються однаково — localePath().
 */
import { locales, localePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '/' } = Astro.props;
---

<nav class="langs" aria-label={ui[locale].header.languages}>
  {
    locales.map((l) => (
      <a href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined} data-lang={l}>
        {l.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .langs {
    display: flex;
    /* 12 + 2 × 4 px внутрішнього відступу = 20 px між кодами, як у Figma */
    gap: 12px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
  }

  /* Зона натискання 44 px заввишки; підкреслення 2 px під кодом */
  .langs a {
    display: inline-flex;
    align-items: center;
    min-width: 32px;
    height: 44px;
    padding: 0 4px;
    color: var(--fg);
    text-decoration: none;
  }

  .langs a {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 4px calc(50% + 13px);
    background-size: 0 2px;
    transition: background-size 0.2s ease;
  }

  .langs a[aria-current='page'],
  .langs a:hover {
    background-size: calc(100% - 8px) 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .langs a {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.langs a[data-lang]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('lindigo-lang', a.dataset.lang ?? '');
      } catch {
        // приватний режим
      }
    }),
  );
</script>
