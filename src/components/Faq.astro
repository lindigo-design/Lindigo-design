---
/**
 * Блок «08 FAQ» (Figma «Головна · Варіант 2», темна й світла тема).
 * Ліворуч заголовок (380 px), праворуч акордеон: питання 24 px, кругла кнопка «+» / «−» 40 px,
 * відкрите питання кольором акценту, відповідь 20 px.
 * Акордеон на <details>/<summary>: працює з клавіатури й без JavaScript.
 * Скрипт лише робить так, що відкрите одне питання за раз (як у макеті).
 *
 * Фон: дві медузи з макета (своя картинка для кожної теми, прозорий фон). Велика — праворуч за
 * питаннями, мала «далеко» — ліворуч, повернута, розмита й напівпрозора. Місця — центри з макета
 * 1512 × 1123 у %, розмір — % ширини блоку. Картинки — з запасом для ретіни (до 2752 px).
 */
import { Image } from 'astro:assets';
import jellyDark from '../assets/faq/jellyfish-dark.webp';
import jellyLight from '../assets/process/jellyfish-light.webp';
// світла велика: та сама медуза, поставлена вертикально (як у макеті), прозорий фон
import jellyLightUpright from '../assets/faq/jellyfish-light-upright.webp';
import { keepLastWords, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].faq;
---

<section class="faq" aria-labelledby="faq-title" data-faq>
  <div class="faq__bg" aria-hidden="true">
    <!-- Темна тема: вертикальна медуза -->
    <div class="faq__jelly faq__jelly--big" data-theme-only="dark">
      <Image src={jellyDark} alt="" widths={[480, 960, 1536]} sizes="(max-width: 760px) 60vw, 31vw" loading="lazy" />
    </div>
    <div class="faq__jelly faq__jelly--far" data-theme-only="dark">
      <Image src={jellyDark} alt="" widths={[240, 480]} sizes="13vw" loading="lazy" />
    </div>
    <!-- Світла тема: та сама медуза, що в «Як ми працюємо», поставлена вертикально -->
    <div class="faq__jelly faq__jelly--big-light" data-theme-only="light">
      <Image src={jellyLightUpright} alt="" widths={[400, 800, 1200]} sizes="(max-width: 1100px) 46vw, 20vw" loading="lazy" />
    </div>
    <div class="faq__jelly faq__jelly--far-light" data-theme-only="light">
      <Image src={jellyLight} alt="" widths={[480, 960]} sizes="23vw" loading="lazy" />
    </div>
  </div>

  <header class="faq__head">
    <p class="faq__eyebrow">{t.eyebrow}</p>
    <h2 class="faq__title" id="faq-title">{t.title}</h2>
  </header>

  <div class="faq__list">
    {
      t.items.map((item, i) => (
        <details class="faq__item" open={i === 0} name="faq">
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <p class="faq__a">{keepLastWords(item.a)}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 380px minmax(0, 1fr);
    column-gap: 80px;
    align-items: start;
    padding: 120px var(--gutter);
    background: var(--section-bg-alt);
    overflow: hidden;
  }

  /* ---------- Медузи (макет 1512 × 1123) ---------- */
  .faq__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .faq__jelly {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: var(--ratio);
    translate: -50% -50%;
    rotate: var(--rot, 0deg);
    opacity: var(--op, 1);
    overflow: hidden;
  }

  .faq__jelly :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Темна: велика 462 × 786 з центром (1126, 672) */
  .faq__jelly--big {
    --x: 74.47%;
    --y: 59.84%;
    --w: 30.56%;
    --ratio: 462 / 786;
  }

  /* Темна: мала 193 × 329, центр (252.6, 702.5), поворот 45°, 40 %, розмиття */
  .faq__jelly--far {
    --x: 16.71%;
    --y: 62.56%;
    --w: 12.76%;
    --ratio: 193 / 329;
    --rot: 45.08deg;
    --op: 0.4;
    filter: blur(5.9px);
  }

  /* Світла: велика вертикальна медуза ≈ 290 × 680 з центром (1185, 685), 80 % */
  .faq__jelly--big-light {
    --x: 78.4%;
    --y: 61%;
    --w: 19.2%;
    --ratio: auto;
    --op: 0.8;
  }

  .faq__jelly--big-light :global(img) {
    height: auto;
    object-fit: contain;
  }

  /* Світла: мала 344.5 × 329 (картинка вписана цілком), центр (289, 622.8), поворот 7.8°, 50 % */
  .faq__jelly--far-light {
    --x: 19.11%;
    --y: 55.46%;
    --w: 22.79%;
    --ratio: 344.5 / 329;
    --rot: -7.81deg;
    --op: 0.5;
    filter: blur(4.15px);
  }

  .faq__jelly--far-light :global(img) {
    object-fit: contain;
  }

  /* Телефон і вузький планшет: мала медуза зайва, велика — тихіше, щоб не заважала читати */
  @media (max-width: 1100px) {
    .faq__jelly--far,
    .faq__jelly--far-light {
      display: none;
    }
    .faq__jelly--big,
    .faq__jelly--big-light {
      --w: 46%;
      --y: 62%;
      opacity: calc(var(--op, 1) * 0.55);
    }
  }


  .faq__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq__eyebrow {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .faq__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 56px;
    line-height: 68px;
  }

  .faq__list {
    border-top: 1px solid var(--step-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--step-border);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    font-weight: 600;
    font-size: 24px;
    line-height: 32px;
    list-style: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:focus-visible {
    outline-offset: 4px;
    border-radius: 8px;
  }

  .faq__item[open] .faq__q {
    padding-bottom: 16px;
    color: var(--accent-text);
  }

  @media (hover: hover) {
    .faq__q:hover {
      color: var(--accent-text);
    }
  }

  /* Кругла кнопка 40 px: «+» закрито, «−» відкрито */
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid color-mix(in srgb, var(--fg) 30%, transparent);
    border-radius: 50%;
    color: color-mix(in srgb, var(--fg) 90%, transparent);
    transition: border-color 0.2s ease;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--dur-btn) var(--ease-out-in);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }

  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__a {
    padding: 0 64px 28px 0;
    font-size: 20px;
    line-height: 30px;
    color: color-mix(in srgb, var(--fg) 85%, transparent);
  }

  @media (max-width: 1100px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }
    .faq__q {
      font-size: 20px;
      line-height: 28px;
    }
    .faq__a {
      font-size: 18px;
      line-height: 28px;
    }
  }

  @media (max-width: 640px) {
    .faq {
      row-gap: 24px;
      padding: 96px 20px;
    }
    .faq__title {
      font-size: 32px;
      line-height: 40px;
    }
    .faq__q {
      padding: 20px 0;
      font-size: 18px;
      line-height: 26px;
    }
    .faq__item[open] .faq__q {
      padding-bottom: 12px;
    }
    .faq__a {
      padding: 0 0 20px;
      font-size: 16px;
      line-height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon::before,
    .faq__icon::after {
      transition: none;
    }
  }
</style>

<script>
  // Відкрите одне питання за раз (у браузерах без атрибута name у <details>)
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('details'));
    items.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) items.forEach((o) => o !== d && (o.open = false));
      }),
    );
  });
</script>
