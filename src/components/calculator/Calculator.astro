---
/**
 * Калькулятор вартості проєкту (Figma «Калькулятор — UI dark (1512)» 353:2854 / light 353:3564 — усі питання;
 * покроковий показ і подяка — фрейми «покроково: крок 3 / крок 5» і «подяка після відправки»).
 * Специфікація, версія 3: шість кроків — 1 напрям, 2 параметри, 3 доповнення, 4 про проєкт, 5 темп, 6 контакти.
 *
 * На екрані лише поточний крок; пройдені згорнуті над ним у рядки «✓ 1 Напрям — … · Змінити».
 * Під кроком — «Далі» і «Назад»; праворуч — панель «Підсумок», що липне під шапкою, її кнопка називає наступний крок.
 * Ціни й логіка — src/data/calculator.ts, тексти — src/i18n/calculator.ts.
 *
 * Розмітку всіх напрямів збираємо одразу; скрипт показує лише обраний. Варіанти — нативні radio / checkbox
 * у картках-label. Без JavaScript калькулятор схований, замість нього — текст і посилання на форму.
 * Крок 6 — форма запиту: надсилається на public/api/calc-request.php (PHP на хостингу); якщо обробника немає
 * (прев'ю на GitHub Pages), пропонуємо надіслати той самий лист зі своєї пошти.
 */
import Button from '../Button.astro';
import Field from '../Field.astro';
import { calculator, type CalcQuestion, type ServiceId } from '../../data/calculator';
import { calcUi, fill } from '../../i18n/calculator';
import { keepLastWords, localePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** Обраний напрям на старті (сторінка послуги); інакше — з ?service= або жодного */
  service?: ServiceId;
}

const { locale, service } = Astro.props;
const t = calcUi[locale];
const contact = localePath(locale, '/contact/');
const privacy = localePath(locale, '/confidentialite/');
const endpoint = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${calculator.endpoint}`;

const qText = (sid: string, qid: string) => t.questions[sid]?.[qid] ?? t.questions.common?.[qid];
const stepLabel = (n: number) => fill(t.stepLabel, { n, name: t.steps[n - 1] });
/** Сітка варіантів: 3 у ряд, для двох і чотирьох варіантів — 2 */
const cols = (q: CalcQuestion) => ((q.options?.length ?? 0) === 2 || (q.options?.length ?? 0) === 4 ? 2 : 3);
/** Мітка кроку — лише над першим питанням кроку (скрипт оновлює, коли питання ховаються) */
const firstOfStep = (qs: CalcQuestion[], i: number) => i === 0 || qs[i - 1].step !== qs[i].step;
/** Пігулки: мови й питання про контекст; «Що хочете зробити із сайтом?» — картки з підписами */
const isPills = (q: CalcQuestion) => q.role === 'languages' || (q.role === 'context' && q.id !== 'siteGoal');
---

<section class="calc" data-calc data-locale={locale} data-service={service} data-endpoint={endpoint} data-email={calculator.contactEmail} aria-label={t.hero.title}>
  <script type="application/json" data-calc-texts set:html={JSON.stringify(t)} />

  <noscript>
    <p class="calc__noscript">
      {t.noscript.text} <a href={`${contact}#message`}>{t.noscript.link}</a>
    </p>
  </noscript>

  <div class="calc__questions">
    <!-- Смуга кроків: пройдені — кнопки («Змінити»), поточний — aria-current -->
    <ol class="calc__steps" aria-label={t.stepsLabel} data-steps>
      {
        t.steps.map((name, i) => (
          <li class="calc__step" data-step-item>
            <button class="calc__step-btn" type="button" data-goto={i + 1} disabled>
              <span class="calc__step-bar" aria-hidden="true" />
              <span class="calc__step-name">
                {i + 1} {name}
              </span>
            </button>
          </li>
        ))
      }
    </ol>
    <!-- Телефон: під смугою — лише назва поточного кроку -->
    <p class="calc__step-now" data-step-now aria-hidden="true"></p>

    <!-- Пройдені кроки, згорнуті в рядки (заповнює скрипт) -->
    <ol class="calc-done" data-done hidden></ol>

    <div class="calc__stage" data-stage>
      <!-- Крок 1. Напрям -->
      <fieldset class="calc-q" data-question="service" data-step="1">
        <legend class="calc-q__head" tabindex="-1">
          <span class="calc-q__eyebrow" data-eyebrow>{stepLabel(1)}</span>
          <span class="calc-q__title">{t.serviceQuestion}</span>
        </legend>
        <div class="calc-q__body">
          <div class="calc-q__options calc-q__options--3">
            {
              calculator.services.map((s) => (
                <label class="calc-opt">
                  <span class="calc-opt__top">
                    <input class="calc-opt__input" type="radio" name="calc-service" value={s.id} />
                    <span class="calc-opt__title">{t.services[s.id].title}</span>
                  </span>
                  <span class="calc-opt__text">{keepLastWords(t.services[s.id].text)}</span>
                </label>
              ))
            }
          </div>
        </div>
      </fieldset>

      {
        calculator.services.map((s) => (
          <div class="calc__group" data-service-group={s.id} hidden>
            {s.questions.map((q, qi) => {
              const qt = qText(s.id, q.id);
              const name = `calc-${s.id}-${q.id}`;
              const hintId = `${name}-hint`;
              return (
                <fieldset class="calc-q" data-question={q.id} data-step={q.step} aria-describedby={qt?.hint ? hintId : undefined}>
                  <legend class="calc-q__head" tabindex="-1">
                    <span class="calc-q__eyebrow" data-eyebrow hidden={!firstOfStep(s.questions, qi)}>
                      {stepLabel(q.step)}
                    </span>
                    <span class="calc-q__title">{qt?.title}</span>
                  </legend>
                  <div class="calc-q__body">
                    {qt?.hint && (
                      <p class="calc-q__hint" id={hintId} data-hint>
                        {keepLastWords(qt.hint)}
                      </p>
                    )}

                    {q.kind === 'counter' && (
                      <div class="calc-counter-wrap">
                        <div class="calc-counter">
                          <button class="calc-counter__btn" type="button" data-dec aria-label={t.counter.minus}>
                            <span aria-hidden="true">−</span>
                          </button>
                          <input class="calc-counter__input" type="number" inputmode="numeric" name={name} aria-label={qt?.title} />
                          <button class="calc-counter__btn" type="button" data-inc aria-label={t.counter.plus}>
                            <span aria-hidden="true">+</span>
                          </button>
                        </div>
                        <p class="calc-q__over" data-over hidden>
                          {fill(t.counter.over, { n: q.customAbove ?? 0 })}
                        </p>
                      </div>
                    )}

                    {isPills(q) && (
                      <div class="calc-pills">
                        {q.options?.map((o) => (
                          <label class="calc-pill">
                            <input class="calc-pill__input" type={q.kind === 'multi' ? 'checkbox' : 'radio'} name={name} value={o.id} />
                            <span>{q.role === 'languages' ? t.languages[o.id] : qt?.options?.[o.id]?.title}</span>
                          </label>
                        ))}
                      </div>
                    )}

                    {q.id === 'deadline' && (
                      <div class="calc-date" data-date hidden>
                        <Field id={`${name}-date`} name={`${name}-date`} type="date" label={t.flow.dateLabel} />
                      </div>
                    )}

                    {q.kind === 'single' && !isPills(q) && (
                      <div class={`calc-q__options calc-q__options--${cols(q)}`}>
                        {q.options?.map((o) => {
                          const ot = qt?.options?.[o.id];
                          return (
                            <label class="calc-opt" data-option={o.id}>
                              <span class="calc-opt__top">
                                <input class="calc-opt__input" type="radio" name={name} value={o.id} />
                                <span class="calc-opt__title">{ot?.title}</span>
                                <span class="calc-badge" data-badge hidden>
                                  {t.flow.recommended}
                                </span>
                              </span>
                              {ot?.text && <span class="calc-opt__text">{keepLastWords(ot.text)}</span>}
                              <span class="calc-opt__price" data-price />
                            </label>
                          );
                        })}
                      </div>
                    )}

                    {q.kind === 'multi' && !isPills(q) && (
                      <div class="calc-q__list">
                        {q.options?.map((o) => {
                          const ot = qt?.options?.[o.id];
                          return (
                            <label class="calc-opt calc-opt--row" data-option={o.id}>
                              <input class="calc-opt__input calc-opt__input--check" type="checkbox" name={name} value={o.id} />
                              <span class="calc-opt__body">
                                <span class="calc-opt__head">
                                  <span class="calc-opt__title">{ot?.title}</span>
                                  <span class="calc-badge" data-badge hidden>
                                    {t.flow.recommended}
                                  </span>
                                </span>
                                {ot?.text && <span class="calc-opt__text">{keepLastWords(ot.text)}</span>}
                              </span>
                              <span class="calc-opt__price" data-price />
                            </label>
                          );
                        })}
                      </div>
                    )}
                  </div>
                </fieldset>
              );
            })}
          </div>
        ))
      }

      <!-- Крок 6. Контакти: форма запиту -->
      <form class="calc-form" data-form novalidate>
        <fieldset class="calc-q" data-question="contact" data-step="6">
          <legend class="calc-q__head" tabindex="-1">
            <span class="calc-q__eyebrow" data-eyebrow>{stepLabel(6)}</span>
            <span class="calc-q__title">{t.contact.title}</span>
          </legend>
          <div class="calc-q__body">
            <Field id="calc-name" name="name" label={`${t.contact.name} *`} autocomplete="name" required liveError />
            <Field id="calc-email" name="email" type="email" label={`${t.contact.email} *`} autocomplete="email" required liveError />
            <!-- Лише якщо сайт є (крок 1); необов'язкове, адресу без https:// доповнюємо самі -->
            <div data-site-url hidden>
              <Field id="calc-site" name="site" type="url" inputmode="url" label={t.contact.site} autocomplete="url" liveError />
            </div>
            <Field id="calc-comment" name="comment" type="textarea" label={t.contact.comment} hint={t.contact.commentHint} />
            <!-- Пастка для ботів: людина поле не бачить (за екраном, без Tab, приховане від скрінрідерів).
                 Назва й підпис нейтральні — не website/company/phone, щоб автозаповнення браузера сюди нічого не вписало -->
            <div class="calc-form__trap" aria-hidden="true">
              <label>Ne pas remplir <input type="text" name="ld_extra" tabindex="-1" autocomplete="off" /></label>
            </div>
          </div>
        </fieldset>

        <fieldset class="calc-q" data-question="call" data-step="6" aria-describedby="calc-call-hint">
          <legend class="calc-q__head" tabindex="-1">
            <span class="calc-q__title">{t.contact.callTitle}</span>
          </legend>
          <div class="calc-q__body">
            <p class="calc-q__hint" id="calc-call-hint">{keepLastWords(t.contact.callHint)}</p>
            <div class="calc-pills">
              <label class="calc-pill">
                <input class="calc-pill__input" type="radio" name="call" value="yes" />
                <span>{t.contact.yes}</span>
              </label>
              <label class="calc-pill">
                <input class="calc-pill__input" type="radio" name="call" value="no" />
                <span>{t.contact.no}</span>
              </label>
            </div>
            <p class="calc-q__note" data-call-link hidden>
              <a href={contact}>{t.contact.callLink}</a>
            </p>
          </div>
        </fieldset>

        <div class="calc-form__submit" data-step-extra="6">
          <Button type="submit">{t.contact.submit}</Button>
          <p class="calc-form__note">
            {keepLastWords(t.contact.note)} <a href={privacy}>{t.contact.privacy}</a>
          </p>
          <!-- role="status" на сторінці від початку, порожній: тоді скрінрідер точно прочитає повідомлення, коли воно з'явиться -->
          <p class="calc-form__status" data-status role="status"></p>
        </div>
      </form>

      <!-- Після відправки: подяка з коротким зведенням -->
      <div class="calc-thanks" data-thanks hidden>
        <div class="calc-thanks__head">
          <p class="calc-q__eyebrow">{t.thanks.eyebrow}</p>
          <h2 class="calc-thanks__title" tabindex="-1" data-thanks-title>{t.thanks.title}</h2>
          <p class="calc-q__hint">{keepLastWords(t.thanks.text)}</p>
        </div>
        <div class="calc-thanks__card">
          <p class="calc-sum__label">{t.thanks.summary}</p>
          <dl class="calc-thanks__list" data-thanks-list></dl>
        </div>
      </div>
    </div>

    <!-- Під кроком: «Далі» (головна) і «Назад» (текстове посилання) -->
    <div class="calc__nav" data-nav>
      <span data-next><Button type="button" describedBy="calc-need-choice">{t.flow.next}</Button></span>
      <button class="calc__back" type="button" data-back hidden>{t.flow.back}</button>
      <p class="visually-hidden" id="calc-need-choice" data-need-choice>{t.flow.needChoice}</p>
    </div>
  </div>

  <aside class="calc-sum" data-summary aria-labelledby="calc-sum-label">
    <p class="calc-sum__label" id="calc-sum-label">{t.summary.label}</p>

    <p class="calc-sum__empty" data-empty>{keepLastWords(t.summary.empty)}</p>

    <div class="calc-sum__body" data-breakdown hidden>
      <div class="calc-sum__total">
        <p class="calc-sum__range" data-range aria-hidden="true"></p>
        <p class="calc-sum__meta" data-meta></p>
      </div>
      <p class="calc-sum__text" data-custom-text hidden>{keepLastWords(t.summary.customText)}</p>
      <hr class="calc-sum__rule" />
      <div class="calc-sum__parts">
        <p class="calc-sum__label">{t.summary.breakdown}</p>
        <ul class="calc-sum__lines" data-lines></ul>
      </div>
      <p class="calc-sum__text" data-advice hidden>{t.summary.advice}</p>
      <p class="calc-sum__text" data-note>{keepLastWords(t.summary.note)}</p>
      <p class="calc-sum__text">{t.summary.vat}</p>
    </div>

    <!-- Сума для екранного читача: лише остаточне значення, без проміжних чисел анімації -->
    <p class="visually-hidden" aria-live="polite" data-live></p>

    <div class="calc-sum__actions">
      <!-- Дублює «Далі» і називає наступний крок; текст ставить скрипт -->
      <span data-panel-next hidden><Button type="button">{t.flow.next}</Button></span>
      <span data-call><Button href={contact} variant="secondary">{t.summary.call}</Button></span>
    </div>
    <button class="calc-sum__restart" type="button" data-restart>{t.summary.restart}</button>
  </aside>

  <!-- Телефон і планшет: сума завжди внизу екрана -->
  <div class="calc-bar" data-bar aria-hidden="true">
    <span class="calc-bar__label">{t.mobile.bar}</span>
    <span class="calc-bar__range" data-bar-range>—</span>
    <a class="calc-bar__link" href="#calc-sum-label" data-bar-link tabindex="-1">{t.mobile.toResult}</a>
  </div>
</section>

<section class="calc-incl" data-calc-included aria-labelledby="calc-incl-title" hidden>
  <header class="calc-incl__head">
    <p class="calc-incl__eyebrow">{t.included.eyebrow}</p>
    <h2 class="calc-incl__title" id="calc-incl-title" data-incl-title></h2>
    <p class="calc-incl__lead">{t.included.lead}</p>
  </header>
  <ol class="calc-incl__cards">
    {
      [1, 2, 3, 4].map((n) => (
        <li class="calc-incl__card" data-incl-item>
          <span class="calc-incl__num">{String(n).padStart(2, '0')}</span>
          <h3 class="calc-incl__name" data-incl-name />
          <p class="calc-incl__text" data-incl-text />
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { initCalculator } from './calculator-client';
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach(initCalculator);
</script>

<style>
  /* ---------- Розкладка: питання ліворуч, підсумок праворуч ---------- */
  /* відступ згори 120 (на телефоні 56), як у інших блоків (рішення Яни 24.11.2026) */
  .calc {
    display: flex;
    align-items: flex-start;
    gap: var(--space-56);
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
  }

  /* Без JavaScript калькулятор не працює: показуємо лише текст із посиланням на форму */
  :global(html:not(.js)) .calc > :not(noscript) {
    display: none;
  }
  .calc__noscript {
    max-width: 665px;
    font-size: var(--text-body-lead);
    line-height: var(--text-body-lead--line-height);
  }
  .calc__noscript a {
    color: var(--accent-text);
  }

  .calc__questions {
    /* картки варіантів шикуються за шириною колонки питань, а не екрана (див. @container нижче) */
    container-type: inline-size;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
  }

  .calc__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
  }
  .calc__group[hidden] {
    display: none;
  }

  /* ---------- Смуга кроків ---------- */
  .calc__steps {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Пункт смуги — кнопка: пройдені кроки клікабельні (= «Змінити»), решта вимкнені */
  .calc__step-btn {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    color: var(--text-muted);
    cursor: default;
  }

  .calc__step-bar {
    height: var(--space-4);
    border-radius: var(--radius-full);
    background: var(--calc-track);
    transition: background-color 0.4s var(--ease-out-in);
  }

  .calc__step-bar {
    width: 100%;
  }

  /* Пройдені: смуга й підпис акценту / тексту, по кліку — повернутися до кроку */
  .calc__step.is-done .calc__step-btn {
    color: var(--fg);
    cursor: pointer;
  }
  .calc__step.is-done .calc__step-bar,
  .calc__step.is-now .calc__step-bar {
    background: var(--accent-text);
  }
  /* Пропущений крок («Змінити окремі сторінки»): сірий, не клікабельний */
  .calc__step.is-skipped .calc__step-btn {
    opacity: var(--disabled-opacity);
  }

  /* Поточний — підпис кольору акценту */
  .calc__step.is-now .calc__step-btn {
    color: var(--accent-text);
  }
  @media (hover: hover) {
    .calc__step.is-done .calc__step-btn:hover .calc__step-name {
      text-decoration: underline;
    }
  }
  .calc__step-btn:focus-visible .calc__step-name {
    text-decoration: underline;
  }

  /* Назва поточного кроку під смугою — лише на телефоні */
  .calc__step-now {
    display: none;
  }

  /* ---------- Пройдені кроки, згорнуті в рядки (Figma «Пройдені кроки») ---------- */
  .calc-done {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .calc-done[hidden] {
    display: none;
  }

  .calc-done :global(.calc-done__row) {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--choice-border);
    border-radius: var(--radius-16);
    background: var(--choice-bg);
  }

  /* Галочка в колі акцентного кольору */
  .calc-done :global(.calc-done__check) {
    flex-shrink: 0;
    display: grid;
    place-content: center;
    width: var(--space-24);
    height: var(--space-24);
    border-radius: 50%;
    background: var(--accent-text);
  }
  .calc-done :global(.calc-done__check)::before {
    content: '';
    width: var(--space-12);
    height: var(--space-12);
    background: var(--bg);
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0, 43% 62%);
  }

  .calc-done :global(.calc-done__body) {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .calc-done :global(.calc-done__name) {
    font-weight: var(--text-title-18--font-weight);
    font-size: var(--text-title-18);
    line-height: var(--text-title-18--line-height);
  }

  .calc-done :global(.calc-done__answer) {
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
    color: var(--text-muted);
  }

  .calc-done :global(.calc-done__change),
  .calc__back {
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-weight: var(--text-button-s--font-weight);
    font-size: var(--text-button-s);
    line-height: var(--text-button-s--line-height);
    text-decoration: underline;
    cursor: pointer;
  }
  @media (hover: hover) {
    .calc-done :global(.calc-done__change:hover),
    .calc__back:hover {
      color: var(--accent-text);
    }
  }
  .calc-done :global(.calc-done__change:focus-visible),
  .calc__back:focus-visible {
    color: var(--accent-text);
  }

  /* ---------- Поточний крок ---------- */
  .calc__stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
  }

  /* Видно лише питання поточного кроку (клас is-current ставить скрипт) */
  :global(.calc.is-flow) .calc-q:not(.is-current),
  :global(.calc.is-flow) [data-step-extra]:not(.is-current) {
    display: none;
  }

  /* Під кроком: «Далі» і текстове «Назад» */
  .calc__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-32);
  }
  .calc__nav[hidden],
  .calc__nav > [hidden],
  .calc__back[hidden] {
    display: none;
  }

  /* ---------- Питання ---------- */
  .calc-q {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    scroll-margin-top: calc(var(--space-120) + var(--space-24));
  }
  .calc-q[hidden] {
    display: none;
  }

  /* Мітка кроку й питання — ближче одне до одного, ніж до варіантів */
  .calc-q__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    margin-bottom: var(--space-24);
    padding: 0;
  }
  /* Підказка йде одразу під заголовком: 8 px, далі 24 до варіантів */
  .calc-q:has(.calc-q__hint) .calc-q__head {
    margin-bottom: var(--space-8);
  }

  .calc-q__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .calc-q__eyebrow {
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .calc-q__title {
    font-family: var(--font-display);
    font-weight: var(--text-h4--font-weight);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    text-wrap: balance;
  }

  .calc-q__hint,
  .calc-q__over {
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
    color: var(--text-muted);
  }
  .calc-q__over {
    color: var(--accent-text);
  }

  .calc-q__options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-16);
  }
  .calc-q__options--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .calc-q__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* ---------- Картка варіанта: нативний radio / checkbox усередині ---------- */
  .calc-opt {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    padding: var(--space-24);
    border: 1px solid var(--choice-border);
    border-radius: var(--radius-16);
    background: var(--choice-bg);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* Доповнення, сховане відповіддю про бренд */
  .calc-opt[hidden] {
    display: none;
  }

  .calc-opt--row {
    flex-direction: row;
    gap: var(--space-16);
  }

  .calc-opt__top {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    width: 100%;
  }

  .calc-opt__body {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .calc-opt__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-12);
  }

  .calc-opt__title {
    flex: 0 1 auto;
    min-width: 0;
    font-weight: var(--text-title-18--font-weight);
    font-size: var(--text-title-18);
    line-height: var(--text-title-18--line-height);
  }

  .calc-opt__text {
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
    color: var(--text-muted);
  }

  .calc-opt__price {
    font-family: var(--font-mono);
    font-weight: var(--text-label-m--font-weight);
    font-size: var(--text-label-m);
    line-height: var(--text-label-m--line-height);
    letter-spacing: var(--text-label-m--letter-spacing);
    white-space: nowrap;
  }
  .calc-opt__price:empty {
    display: none;
  }

  /* «Рекомендовано»: обвідна пігулка акцентного кольору (Figma, «Позначка: Рекомендовано») */
  .calc-badge {
    flex-shrink: 0;
    padding: var(--space-4) var(--space-12);
    border: 1px solid var(--accent-text);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
    white-space: nowrap;
  }
  .calc-badge[hidden] {
    display: none;
  }

  /* Підказка під варіантами: «Ми можемо оновити наявний сайт…», посилання на дзвінок */
  .calc-q__note {
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
    color: var(--accent-text);
  }
  .calc-q__note[hidden],
  .calc-date[hidden] {
    display: none;
  }
  .calc-q__note a {
    color: inherit;
  }

  .calc-date {
    max-width: 320px;
  }

  /* ---------- Крок 6: форма ---------- */
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
  }
  .calc-form[hidden] {
    display: none;
  }

  /* Пастка для ботів: поза екраном, не в порядку фокусу */
  .calc-form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .calc-form__submit {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .calc-form__note,
  .calc-form__status {
    max-width: 665px;
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
    color: var(--text-muted);
  }
  .calc-form__note a,
  .calc-form__status a {
    color: var(--fg);
  }
  .calc-form__status {
    color: var(--danger);
  }
  /* Порожній — не займає місця й не додає проміжок, але лишається на сторінці для скрінрідерів */
  .calc-form__status:empty {
    position: absolute;
  }

  /* ---------- Подяка після відправки ---------- */
  .calc-thanks {
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
  }
  .calc-thanks[hidden] {
    display: none;
  }

  .calc-thanks__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .calc-thanks__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--text-h4--font-weight);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    text-wrap: balance;
  }

  .calc-thanks__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-32);
    border: 1px solid var(--choice-border);
    border-radius: var(--radius-24);
    background: var(--choice-bg);
  }

  .calc-thanks__list {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-12) var(--space-24);
    margin: 0;
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
  }
  .calc-thanks__list :global(dt) {
    color: var(--text-muted);
  }
  .calc-thanks__list :global(dd) {
    margin: 0;
    text-align: right;
  }

  /* Радіо: кільце 20 px, обране — з точкою кольору акценту */
  .calc-opt__input {
    flex-shrink: 0;
    display: grid;
    place-content: center;
    width: 20px;
    height: 20px;
    margin: 0;
    border: 1.5px solid var(--fg);
    border-radius: 50%;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }
  .calc-opt__input::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-text);
    transform: scale(0);
    transition: transform 0.2s var(--ease-out-in);
  }
  .calc-opt__input:checked {
    border-color: var(--accent-text);
  }
  .calc-opt__input:checked::before {
    transform: scale(1);
  }

  /* Чекбокс: квадрат 20 px з галочкою; стоїть на рівні назви */
  .calc-opt__input--check {
    margin-top: var(--space-4);
    border-radius: calc(var(--radius-8) / 2);
  }
  .calc-opt__input--check::before {
    width: 12px;
    height: 12px;
    border-radius: 0;
    background: var(--bg);
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0, 43% 62%);
  }
  .calc-opt__input--check:checked {
    background: var(--accent-text);
  }

  .calc-opt--row .calc-opt__price {
    margin-top: var(--space-4);
  }

  /* Обраний варіант */
  .calc-opt:has(:checked) {
    border-color: var(--choice-selected-border);
    box-shadow: inset 0 0 0 1px var(--choice-selected-border);
    background: var(--choice-selected-bg);
  }
  .calc-opt:has(:checked) .calc-opt__price {
    color: var(--accent-text);
  }

  /* Наведення і фокус з клавіатури — однакова обводка; контур фокусу видно */
  @media (hover: hover) {
    .calc-opt:hover:not(:has(:checked)) {
      border-color: var(--more-border);
    }
  }
  .calc-opt:has(:focus-visible) {
    border-color: var(--more-border);
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }
  .calc-opt__input:focus-visible {
    outline: none;
  }

  /* ---------- Лічильник ---------- */
  .calc-counter-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
  }

  .calc-counter {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--fg);
    border-radius: var(--radius-full);
  }

  .calc-counter__btn,
  .calc-counter__input {
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--fg);
    font: inherit;
    text-align: center;
  }

  .calc-counter__btn {
    font-size: var(--text-body-l);
    line-height: var(--text-body-l--line-height);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  @media (hover: hover) {
    .calc-counter__btn:not(:disabled):hover {
      background: var(--ring-press);
    }
  }
  .calc-counter__btn:not(:disabled):active {
    background: var(--ring-press);
  }
  .calc-counter__btn:disabled {
    opacity: var(--disabled-opacity);
    cursor: not-allowed;
  }

  .calc-counter__input {
    font-weight: var(--text-title-18--font-weight);
    font-size: var(--text-title-18);
    line-height: var(--text-title-18--line-height);
    appearance: textfield;
  }
  .calc-counter__input::-webkit-inner-spin-button,
  .calc-counter__input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  /* ---------- Перемикач мов: «таблетки» з radio ---------- */
  .calc-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .calc-pill {
    position: relative;
    padding: var(--space-12) var(--space-28);
    border: 1px solid var(--fg);
    border-radius: var(--radius-full);
    font-weight: var(--text-button-m--font-weight);
    font-size: var(--text-button-m);
    line-height: var(--text-button-m--line-height);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .calc-pill__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  @media (hover: hover) {
    .calc-pill:hover:not(:has(:checked)) {
      background: var(--ring-press);
    }
  }
  .calc-pill:has(:checked) {
    background: var(--fg);
    color: var(--bg);
  }
  .calc-pill:has(:focus-visible) {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }

  /* ---------- Підсумок (липне під шапкою: шапка ~114 px + 32) ---------- */
  .calc-sum {
    position: sticky;
    top: calc(var(--space-120) + var(--space-24));
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 440px;
    padding: var(--space-32);
    border: 1px solid var(--calc-panel-border);
    border-radius: var(--radius-32);
    background: var(--calc-panel-bg);
    scroll-margin-top: calc(var(--space-120) + var(--space-24));
  }

  .calc-sum__label {
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .calc-sum__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .calc-sum__body[hidden],
  .calc-sum__empty[hidden],
  .calc-sum__text[hidden] {
    display: none;
  }

  .calc-sum__total {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .calc-sum__range {
    font-family: var(--font-display);
    font-weight: var(--text-h3-s--font-weight);
    font-size: var(--text-h3-s);
    line-height: var(--text-h3-s--line-height);
    font-variant-numeric: tabular-nums;
  }
  /* «Потрібна індивідуальна оцінка» — довший текст, менший стиль */
  :global(.calc.is-custom) .calc-sum__range {
    font-size: var(--text-h5);
    line-height: var(--text-h5--line-height);
  }

  .calc-sum__meta {
    font-family: var(--font-mono);
    font-weight: var(--text-label-m--font-weight);
    font-size: var(--text-label-m);
    line-height: var(--text-label-m--line-height);
    letter-spacing: var(--text-label-m--letter-spacing);
    color: var(--text-muted);
  }

  .calc-sum__rule {
    width: 100%;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--calc-track);
  }

  .calc-sum__parts {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .calc-sum__parts[hidden] {
    display: none;
  }

  .calc-sum__lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .calc-sum__lines :global(.calc-sum__line) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
  }

  .calc-sum__lines :global(.calc-sum__amount) {
    flex-shrink: 0;
    font-weight: var(--text-title-16--font-weight);
    white-space: nowrap;
  }

  .calc-sum__empty,
  .calc-sum__text {
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
    color: var(--text-muted);
  }

  .calc-sum__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .calc-sum__actions > span,
  .calc-sum__actions :global(.btn) {
    display: flex;
    width: 100%;
  }
  .calc-sum__actions > span[hidden] {
    display: none;
  }

  .calc-sum__restart {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-weight: var(--text-button-s--font-weight);
    font-size: var(--text-button-s);
    line-height: var(--text-button-s--line-height);
    text-decoration: underline;
    cursor: pointer;
  }
  @media (hover: hover) {
    .calc-sum__restart:hover {
      color: var(--fg);
    }
  }
  .calc-sum__restart:focus-visible {
    color: var(--fg);
  }

  /* ---------- Нижня панель із сумою: лише телефон і планшет ---------- */
  .calc-bar {
    display: none;
  }

  /* ---------- «Що входить у вартість» ---------- */
  .calc-incl {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
  }
  .calc-incl[hidden] {
    display: none;
  }

  .calc-incl__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .calc-incl__eyebrow {
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .calc-incl__title {
    font-family: var(--font-display);
    font-weight: var(--text-h2--font-weight);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
  }

  .calc-incl__lead {
    font-size: var(--text-body-l);
    line-height: var(--text-body-l--line-height);
  }

  .calc-incl__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .calc-incl__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-32);
    border: 1px solid var(--choice-border);
    border-radius: var(--radius-32);
    background: var(--choice-bg);
  }
  .calc-incl__card[hidden] {
    display: none;
  }

  .calc-incl__num {
    font-family: var(--font-mono);
    font-weight: var(--text-label-m--font-weight);
    font-size: var(--text-label-m);
    line-height: var(--text-label-m--line-height);
    letter-spacing: var(--text-label-m--letter-spacing);
    color: var(--accent-text);
  }

  .calc-incl__name {
    font-family: var(--font-display);
    font-weight: var(--text-h5--font-weight);
    font-size: var(--text-h5);
    line-height: var(--text-h5--line-height);
  }

  .calc-incl__text {
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
  }

  /* ---------- Планшет: підсумок під питаннями, сума — у панелі внизу екрана ---------- */
  @media (max-width: 1100px) {
    .calc {
      flex-direction: column;
      align-items: stretch;
    }
    .calc__questions {
      flex: none;
    }
    .calc-sum {
      position: static;
      width: 100%;
    }
    .calc-incl__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .calc-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 40;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4) var(--space-16);
      padding: var(--space-16) var(--gutter);
      border-top: 1px solid var(--calc-panel-border);
      background: var(--calc-panel-bg);
    }
    :global(.calc.is-empty) .calc-bar {
      display: none;
    }
    .calc-bar__label {
      width: 100%;
      font-family: var(--font-mono);
      font-weight: var(--text-label-s--font-weight);
      font-size: var(--text-label-s);
      line-height: var(--text-label-s--line-height);
      letter-spacing: var(--text-label-s--letter-spacing);
      text-transform: uppercase;
      color: var(--accent-text);
    }
    .calc-bar__range {
      flex: 1 1 auto;
      font-family: var(--font-display);
      font-weight: var(--text-h5--font-weight);
      font-size: var(--text-h5);
      line-height: var(--text-h5--line-height);
    }
    .calc-bar__link {
      font-weight: var(--text-button-s--font-weight);
      font-size: var(--text-button-s);
      line-height: var(--text-button-s--line-height);
      color: var(--fg);
    }
  }

