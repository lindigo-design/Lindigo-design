---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './hero/Hero.astro';
import Footer from './Footer.astro';
import Menu from './Menu.astro';
import Directions from './Directions.astro';
import Principles from './Principles.astro';
import Works from './Works.astro';
import Process from './Process.astro';
import PhotoStrip from './PhotoStrip.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<Base locale={locale} title={t.meta.title} description={t.meta.description}>
  <Header locale={locale} />
  <Menu locale={locale} />
  <main>
    <Hero locale={locale} />
    <Directions locale={locale} />
    <Principles locale={locale} />
    <Works locale={locale} />
    <Process locale={locale} />
    <PhotoStrip locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
