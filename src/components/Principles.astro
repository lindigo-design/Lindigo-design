---
/**
 * Блок «02 Принципи» (Figma «02 Принципи new», темна й світла тема).
 * Згори: підпис «Наші принципи» і великий заголовок із двох речень (перше сіре, друге кольором теми).
 * Під ним три колонки 296 | 525 | 435 (між ними 48): ліва — місце під фото (поки порожнє), текст, фото.
 * Знизу чотири принципи з лінією згори. Фон — бежевий у світлій темі, у темній — світіння «Light».
 */
import { Image } from 'astro:assets';
import laptop from '../assets/principles/laptop.jpg';
import { keepLastWords, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].principles;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="principles glow-studio" aria-labelledby="principles-title">
  <div class="principles__top">
    <p class="principles__eyebrow">{t.eyebrow}</p>
    <h2 class="principles__lead" id="principles-title">
      <span class="principles__muted">{t.leadMuted}</span>
      {' '}<span class="principles__strong">{keepLastWords(t.lead)}</span>
    </h2>
    <div class="principles__body">
      {t.body.map((para) => <p>{keepLastWords(para)}</p>)}
    </div>
    <div class="principles__media">
      <Image src={laptop} alt="" widths={[440, 880, 1200]} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 280px, 435px" />
    </div>
  </div>

  <ol class="principles__list">
    {
      t.items.map((item, i) => (
        <li class="principle">
          <p class="principle__num" aria-hidden="true">{pad(i + 1)}</p>
          <h3 class="principle__title">{item.title}</h3>
          <p class="principle__text">{keepLastWords(item.text)}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .principles {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding: 120px var(--gutter);
    background: var(--section-bg-alt);
  }

  :global(:root:not([data-theme='light'])) .principles {
    background: var(--glow-studio), var(--section-bg-alt);
  }

  /* Сітка 296 | 525 | 435 на 1512 (разом 1352 з проміжками 48), на вужчих — у тих самих пропорціях */
  .principles__top {
    display: grid;
    grid-template-columns: minmax(0, 296fr) minmax(0, 525fr) minmax(0, 435fr);
    column-gap: 48px;
    row-gap: 40px;
    align-items: start;
  }

  /* Підпис — у лівій колонці від краю; заголовок стоїть над колонкою тексту */
  .principles__eyebrow {
    grid-area: 1 / 1;
    padding-top: clamp(6px, 0.86vw, 13px);
    font-family: var(--font-mono);
    font-weight: var(--text-label-m--font-weight);
    font-size: var(--text-label-m);
    line-height: var(--text-label-m--line-height);
    letter-spacing: var(--text-label-m--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* Кожне речення з нового рядка: сіре — завжди одним рядком, друге переноситься лише тоді,
     коли не влазить до правого краю (на 1512 — 3 рядки, як у макеті; на широких екранах буває 2) */
  .principles__lead {
    grid-area: 1 / 2 / 2 / 4;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.65vw, 2.5rem);
    line-height: clamp(2rem, 4.1vw, 3.875rem);
  }

  .principles__lead > span {
    display: block;
  }

  .principles__muted {
    color: var(--text-supplement);
  }

  @media (min-width: 1101px) {
    .principles__muted {
      white-space: nowrap;
    }
  }

  .principles__body {
    grid-area: 2 / 2;
    display: flex;
    flex-direction: column;
    gap: 1em;
    font-weight: 500;
    font-size: var(--text-body-lead);
    line-height: var(--text-body-lead--line-height);
    color: var(--text-soft);
  }

  /* 435 × 260 на 1512; на ширших екранах росте разом із колонкою, пропорція та сама */
  .principles__media {
    grid-area: 2 / 3;
    aspect-ratio: var(--aspect-principles-photo);
    overflow: hidden;
    border-radius: var(--radius-20);
  }

  .principles__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Чотири принципи по ширині блоку: на 1512 колонки ≈ 300, між ними 48; лінія згори */
  .principles__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }

  .principle__num,
  .principle__title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem; /* 12px */
    letter-spacing: 0.08em;
  }

  .principle__num {
    line-height: 133.3333%; /* 16px */
    color: var(--accent-text);
  }

  .principle__title {
    line-height: 150%; /* 18px */
    text-transform: uppercase;
  }

  .principle__text {
    font-weight: 500;
    font-size: 0.875rem; /* 14px */
    line-height: 150%;
  }

  /* Вужчий комп'ютер і планшет: підпис над заголовком, порожньої колонки немає, фото поруч із текстом */
  @media (max-width: 1100px) {
    .principles__top {
      grid-template-columns: minmax(0, 1fr) 280px;
      row-gap: 16px;
    }
    .principles__eyebrow {
      grid-area: 1 / 1 / 2 / 3;
      padding: 0;
    }
    .principles__lead {
      grid-area: 2 / 1 / 3 / 3;
    }
    .principles__body {
      grid-area: 3 / 1;
      margin-top: 24px;
      font-size: var(--text-body-l);
      line-height: var(--text-body-l--line-height);
    }
    .principles__media {
      grid-area: 3 / 2;
      margin-top: 24px;
      aspect-ratio: auto;
      height: 240px;
    }
    .principles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 48px;
    }
  }

  /* Один стовпчик: фото під текстом */
  @media (max-width: 760px) {
    .principles {
      gap: 48px;
    }
    .principles__top {
      grid-template-columns: minmax(0, 1fr);
    }
    .principles__media {
      grid-area: 4 / 1;
      width: 100%;
      height: auto;
      aspect-ratio: var(--aspect-photo-wide);
      margin-top: 16px;
    }
  }

  /* Телефон */
  @media (max-width: 640px) {
    .principles {
      padding: var(--space-56) var(--space-20);
    }
    .principles__body {
      font-size: var(--text-body-m);
      line-height: var(--text-body-m--line-height);
    }
    .principles__media {
      border-radius: var(--radius-16);
    }
  }

  @media (max-width: 480px) {
    .principles__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
