---
/**
 * Курсор сайту — «медуза»: кільце-купол з аурою і тонкі щупальця.
 *
 * Кільце 32 px іде за курсором по всьому сайту. Обводка — той самий градієнт, що й у кнопок
 * на hover (--ring-from → --ring-to, повільно обертається), навколо м'яка аура. Над посиланнями
 * й кнопками кільце трохи більшає, аура яскравішає. Системний курсор лишається.
 *
 * Щупальця: 4 тонкі нитки звисають з нижнього краю кільця, звужуються й тануть до кінчиків
 * (градієнт --ring-from → --ring-to, як прожилки медузи з блоку «Як ми працюємо»). Під час руху
 * відстають і тягнуться за куполом, як у воді; коли мишка стоїть — спокійно звисають і ледь
 * гойдаються. Сила — TENTACLE_ALPHA у скрипті. На першому екрані щупальця ховаються:
 * там рідина сама реагує на мишку.
 *
 * Лише для миші. З «зменшити рух» — тільки кільце, без щупалець і обертання.
 * Поки відкрите меню — щупальця сховані.
 */
---

<canvas class="cursor-trail" aria-hidden="true" data-cursor-trail></canvas>
<div class="cursor-ring" aria-hidden="true" data-cursor-ring></div>

<style>
  @property --cursor-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .cursor-trail {
    position: fixed;
    inset: 0;
    z-index: 199;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .cursor-ring {
    --size: 32px;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 200;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    /* аура: м'яке світіння кольором обводки */
    box-shadow:
      0 0 10px color-mix(in srgb, var(--ring-from) 30%, transparent),
      inset 0 0 6px color-mix(in srgb, var(--ring-from) 18%, transparent);
    transition:
      opacity 0.3s ease,
      width 0.25s var(--ease-out-in),
      height 0.25s var(--ease-out-in),
      margin 0.25s var(--ease-out-in),
      box-shadow 0.25s ease;
    will-change: transform, opacity;
  }

  /* Обводка-градієнт 1.5 px, як у .ring-hover */
  .cursor-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(from var(--cursor-angle), var(--ring-from), var(--ring-to), var(--ring-from));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    animation: cursor-ring-run 4s linear infinite;
  }

  .cursor-ring.is-visible {
    opacity: 1;
  }

  /* Над посиланням чи кнопкою */
  .cursor-ring.is-hover {
    --size: 44px;
    box-shadow:
      0 0 16px color-mix(in srgb, var(--ring-from) 45%, transparent),
      inset 0 0 8px color-mix(in srgb, var(--ring-from) 24%, transparent);
  }

  @keyframes cursor-ring-run {
    to {
      --cursor-angle: 360deg;
    }
  }

  @media not ((hover: hover) and (pointer: fine)) {
    .cursor-ring,
    .cursor-trail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-ring::before {
      animation: none;
    }
    .cursor-trail {
      display: none;
    }
  }
</style>

<script>
  const ring = document.querySelector<HTMLElement>('[data-cursor-ring]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-cursor-trail]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /** Непрозорість щупалець біля купола (0–1); до кінчиків тануть до нуля. Підсилити — збільшити. */
  const TENTACLE_ALPHA = 0.55;
  /** Звідки ростуть щупальця: кут від низу кільця, градуси */
  const ANCHORS = [-50, -18, 18, 50];
  /** Ланок у щупальці й довжина ланки, px (разом ≈ 60 px) */
  const SEGMENTS = 10;
  const SEG_LEN = 6;
  /** Що вважаємо «посиланням чи кнопкою» — над ними кільце більшає */
  const INTERACTIVE = 'a, button, summary, label, select, input, textarea, [role="button"], [tabindex]:not([tabindex="-1"])';

  if (ring && canvas) {
    const ctx = canvas.getContext('2d');
    let tx = 0, ty = 0, x = 0, y = 0, placed = false, visible = false;
    let raf = 0, menuOpen = false, overHero = false, hover = false;
    let fade = 0; // видимість щупалець 0–1, змінюється плавно
    let colors: [string, string] = ['#dda3f7', '#f2632a'];

    type P = { x: number; y: number; px: number; py: number };
    const tentacles: P[][] = ANCHORS.map(() =>
      Array.from({ length: SEGMENTS + 1 }, () => ({ x: 0, y: 0, px: 0, py: 0 })),
    );

    const readColors = () => {
      const css = getComputedStyle(document.documentElement);
      colors = [
        css.getPropertyValue('--ring-from').trim() || colors[0],
        css.getPropertyValue('--ring-to').trim() || colors[1],
      ];
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(window.innerWidth * dpr);
      canvas.height = Math.round(window.innerHeight * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const wanted = () => visible && !reduceMotion.matches && !menuOpen && !overHero;

    // точка кріплення щупальця k на нижньому краї кільця
    const anchorOf = (k: number) => {
      const r = (hover ? 22 : 16) * 0.92;
      const a = (ANCHORS[k] * Math.PI) / 180;
      return { ax: x + Math.sin(a) * r, ay: y + Math.cos(a) * r };
    };

    const placeTentacles = () => {
      tentacles.forEach((pts, k) => {
        const { ax, ay } = anchorOf(k);
        pts.forEach((p, i) => {
          p.x = p.px = ax;
          p.y = p.py = ay + i * SEG_LEN;
        });
      });
    };

    const simulate = (time: number) => {
      tentacles.forEach((pts, k) => {
        const { ax, ay } = anchorOf(k);
        pts[0].x = ax;
        pts[0].y = ay;
        for (let i = 1; i < pts.length; i++) {
          const p = pts[i];
          // інерція з загасанням (як у воді), легке «падіння» вниз і гойдання
          const vx = (p.x - p.px) * 0.86;
          const vy = (p.y - p.py) * 0.86;
          p.px = p.x;
          p.py = p.y;
          const sway = Math.sin(time / 520 + k * 1.7 + i * 0.45) * 0.06 * (i / pts.length);
          p.x += vx + sway;
          p.y += vy + 0.22;
        }
        // ланки тримають свою довжину
        for (let pass = 0; pass < 2; pass++) {
          for (let i = 1; i < pts.length; i++) {
            const a = pts[i - 1];
            const b = pts[i];
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const d = Math.hypot(dx, dy) || 1;
            const f = (d - SEG_LEN) / d;
            b.x -= dx * f;
            b.y -= dy * f;
          }
        }
      });
    };

    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      if (fade <= 0.01) return;
      ctx.lineCap = 'round';
      tentacles.forEach((pts) => {
        const head = pts[0];
        const tail = pts[pts.length - 1];
        const g = ctx.createLinearGradient(head.x, head.y, tail.x, tail.y);
        g.addColorStop(0, colors[0]);
        g.addColorStop(1, colors[1]);
        ctx.strokeStyle = g;
        for (let i = 1; i < pts.length; i++) {
          const t = i / (pts.length - 1);
          // звужується й тане до кінчика
          ctx.globalAlpha = TENTACLE_ALPHA * fade * Math.pow(1 - t, 1.4);
          ctx.lineWidth = 1.8 * (1 - t) + 0.4;
          ctx.beginPath();
          ctx.moveTo(pts[i - 1].x, pts[i - 1].y);
          ctx.lineTo(pts[i].x, pts[i].y);
          ctx.stroke();
        }
      });
      ctx.globalAlpha = 1;
    };

    const tick = (time: number) => {
      // кільце: легке запізнення (≈ 35 % відстані за кадр)
      x += (tx - x) * 0.35;
      y += (ty - y) * 0.35;
      ring.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      fade += ((wanted() ? 1 : 0) - fade) * 0.15;
      if (fade > 0.01) simulate(time);
      draw();

      const moving = Math.abs(tx - x) + Math.abs(ty - y) > 0.3;
      // поки щупальця видимі, вони гойдаються — цикл працює; інакше зупиняється
      raf = moving || fade > 0.01 || wanted() ? requestAnimationFrame(tick) : 0;
    };

    const start = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse' || !finePointer.matches) return;
        tx = e.clientX;
        ty = e.clientY;
        if (!placed || reduceMotion.matches) {
          x = tx;
          y = ty;
          ring.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          if (!placed) placeTentacles();
          placed = true;
        }
        visible = true;
        ring.classList.add('is-visible');

        const target = e.target instanceof Element ? e.target : null;
        hover = !!target?.closest(INTERACTIVE);
        ring.classList.toggle('is-hover', hover);
        overHero = !!target?.closest('[data-hero]');
        start();
      },
      { passive: true },
    );

    // курсор вийшов за межі вікна — ховаємо кільце й щупальця
    document.documentElement.addEventListener('mouseleave', () => {
      visible = false;
      ring.classList.remove('is-visible');
      start();
    });

    window.addEventListener('lindigo:menu', (e) => {
      menuOpen = !!(e as CustomEvent<{ open: boolean }>).detail?.open;
      start();
    });

    // тема змінилась — нові кольори щупалець
    new MutationObserver(readColors).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    window.addEventListener('resize', resize);
    readColors();
    resize();
  }
</script>
