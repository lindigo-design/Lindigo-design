---
/**
 * Курсор сайту — «медуза»: кільце-купол з аурою і тонкі щупальця.
 *
 * Кільце 32 px іде за курсором по всьому сайту. Обводка — той самий градієнт, що й у кнопок
 * на hover (--ring-from → --ring-to, повільно обертається), навколо м'яка аура. Над посиланнями
 * й кнопками кільце трохи більшає, аура яскравішає. Системний курсор лишається.
 *
 * Коли мишка стоїть — лише кільце, яке повільно «дихає» (стискається й розширюється, 2,6 с).
 * Під час руху з тильного боку кільця віялом тягнуться 5 тонких щупалець (20–45 px),
 * по кожному повільно біжить хвиля, як у воді; градієнт --ring-from → --ring-to, звужуються
 * й тануть до кінчиків. Після зупинки щупальця тануть за ≈ 0,5 с. Сила — TENTACLE_ALPHA.
 * На першому екрані щупалець немає: там рідина сама реагує на мишку.
 *
 * Лише для миші. З «зменшити рух» — тільки кільце, без щупалець, обертання й «дихання».
 * Поки відкрите меню — щупальця сховані.
 */
---

<canvas class="cursor-trail" aria-hidden="true" data-cursor-trail></canvas>
<div class="cursor-ring" aria-hidden="true" data-cursor-ring></div>

<style>
  @property --cursor-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .cursor-trail {
    position: fixed;
    inset: 0;
    z-index: 199;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .cursor-ring {
    --size: 32px;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 200;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    /* аура: м'яке світіння кольором обводки */
    box-shadow:
      0 0 10px color-mix(in srgb, var(--ring-from) 30%, transparent),
      inset 0 0 6px color-mix(in srgb, var(--ring-from) 18%, transparent);
    transition:
      opacity 0.3s ease,
      width 0.25s var(--ease-out-in),
      height 0.25s var(--ease-out-in),
      margin 0.25s var(--ease-out-in),
      box-shadow 0.25s ease;
    will-change: transform, opacity;
  }

  /* Обводка-градієнт 1.5 px, як у .ring-hover */
  .cursor-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(from var(--cursor-angle), var(--ring-from), var(--ring-to), var(--ring-from));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    animation: cursor-ring-run 4s linear infinite;
  }

  .cursor-ring.is-visible {
    opacity: 1;
  }

  /* Мишка стоїть — кільце повільно «дихає», як медуза, що пливе */
  .cursor-ring.is-idle {
    animation: cursor-breathe 2.6s ease-in-out infinite;
  }

  @keyframes cursor-breathe {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 0.9;
    }
  }

  /* Над посиланням чи кнопкою */
  .cursor-ring.is-hover {
    --size: 44px;
    box-shadow:
      0 0 16px color-mix(in srgb, var(--ring-from) 45%, transparent),
      inset 0 0 8px color-mix(in srgb, var(--ring-from) 24%, transparent);
  }

  @keyframes cursor-ring-run {
    to {
      --cursor-angle: 360deg;
    }
  }

  @media not ((hover: hover) and (pointer: fine)) {
    .cursor-ring,
    .cursor-trail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-ring::before,
    .cursor-ring.is-idle {
      animation: none;
    }
    .cursor-trail {
      display: none;
    }
  }
</style>

<script>
  const ring = document.querySelector<HTMLElement>('[data-cursor-ring]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-cursor-trail]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /** Непрозорість щупалець біля кільця (0–1); до кінчиків тануть до нуля. Підсилити — збільшити. */
  const TENTACLE_ALPHA = 0.6;
  /** Довжини 5 щупалець, px */
  const LENGTHS = [20, 32, 45, 38, 26];
  /** Віяло з тильного боку кільця: кути від напрямку «назад», градуси */
  const SPREAD = [-44, -22, 0, 22, 44];
  /** Ланок у кожному щупальці */
  const SEGMENTS = 9;
  /** За скільки щупальця тануть після зупинки, мс */
  const FADE_OUT = 500;
  /** Хвиля: висота (px біля кінчика), довжина (ланок), швидкість (рад/мс) */
  const WAVE_AMP = 3.2;
  const WAVE_LEN = 4.5;
  const WAVE_SPEED = 0.006;
  /** Що вважаємо «посиланням чи кнопкою» — над ними кільце більшає */
  const INTERACTIVE = 'a, button, summary, label, select, input, textarea, [role="button"], [tabindex]:not([tabindex="-1"])';

  if (ring && canvas) {
    const ctx = canvas.getContext('2d');
    let tx = 0, ty = 0, x = 0, y = 0, placed = false, visible = false;
    let raf = 0, menuOpen = false, overHero = false, hover = false;
    let lastMove = 0, lastTime = 0, fade = 0;
    // згладжений напрямок руху — щупальця тягнуться в протилежний бік
    let dirX = 1, dirY = 0;
    let colors: [string, string] = ['#dda3f7', '#f2632a'];

    type P = { x: number; y: number };
    const tentacles: P[][] = LENGTHS.map(() => Array.from({ length: SEGMENTS + 1 }, () => ({ x: 0, y: 0 })));

    const readColors = () => {
      const css = getComputedStyle(document.documentElement);
      colors = [
        css.getPropertyValue('--ring-from').trim() || colors[0],
        css.getPropertyValue('--ring-to').trim() || colors[1],
      ];
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(window.innerWidth * dpr);
      canvas.height = Math.round(window.innerHeight * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const allowed = () => visible && !reduceMotion.matches && !menuOpen && !overHero;

    // точка на краю кільця з тильного боку (кут k-го щупальця у віялі)
    const anchorOf = (k: number) => {
      const r = (hover ? 22 : 16) * 0.95;
      const back = Math.atan2(-dirY, -dirX) + (SPREAD[k] * Math.PI) / 180;
      return { ax: x + Math.cos(back) * r, ay: y + Math.sin(back) * r, back };
    };

    const resetTentacles = () => {
      tentacles.forEach((pts, k) => {
        const { ax, ay, back } = anchorOf(k);
        const seg = LENGTHS[k] / SEGMENTS;
        pts.forEach((p, i) => {
          p.x = ax + Math.cos(back) * seg * i;
          p.y = ay + Math.sin(back) * seg * i;
        });
      });
    };

    // кожна точка тягнеться за попередньою (як нитка у воді)
    const follow = () => {
      tentacles.forEach((pts, k) => {
        const { ax, ay } = anchorOf(k);
        const seg = LENGTHS[k] / SEGMENTS;
        pts[0].x = ax;
        pts[0].y = ay;
        for (let i = 1; i < pts.length; i++) {
          const a = pts[i - 1];
          const b = pts[i];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const d = Math.hypot(dx, dy) || 1;
          b.x = a.x + (dx / d) * seg;
          b.y = a.y + (dy / d) * seg;
        }
      });
    };

    const draw = (time: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      if (fade <= 0.01) return;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      tentacles.forEach((pts, k) => {
        // хвиля: зсув упоперек нитки, росте до кінчика й біжить від кільця
        const wavy = pts.map((p, i) => {
          if (i === 0) return p;
          const a = pts[i - 1];
          const dx = p.x - a.x;
          const dy = p.y - a.y;
          const d = Math.hypot(dx, dy) || 1;
          const t = i / SEGMENTS;
          const off = Math.sin(i / WAVE_LEN * Math.PI * 2 - time * WAVE_SPEED + k * 1.3) * WAVE_AMP * t;
          return { x: p.x + (-dy / d) * off, y: p.y + (dx / d) * off };
        });
        const head = wavy[0];
        const tail = wavy[wavy.length - 1];
        const g = ctx.createLinearGradient(head.x, head.y, tail.x, tail.y);
        g.addColorStop(0, colors[0]);
        g.addColorStop(1, colors[1]);
        ctx.strokeStyle = g;
        // плавна крива через середини ланок; нитка звужується й тане до кінчика
        for (let i = 1; i < wavy.length; i++) {
          const t = i / SEGMENTS;
          const p0 = i === 1 ? wavy[0] : { x: (wavy[i - 2].x + wavy[i - 1].x) / 2, y: (wavy[i - 2].y + wavy[i - 1].y) / 2 };
          const p1 = wavy[i - 1];
          const p2 = { x: (wavy[i - 1].x + wavy[i].x) / 2, y: (wavy[i - 1].y + wavy[i].y) / 2 };
          ctx.globalAlpha = TENTACLE_ALPHA * fade * Math.pow(1 - t + 1 / SEGMENTS, 1.3);
          ctx.lineWidth = 1.6 * (1 - t) + 0.5;
          ctx.beginPath();
          ctx.moveTo(p0.x, p0.y);
          ctx.quadraticCurveTo(p1.x, p1.y, p2.x, p2.y);
          ctx.stroke();
        }
      });
      ctx.globalAlpha = 1;
    };

    const tick = (time: number) => {
      const dt = lastTime ? Math.min(50, time - lastTime) : 16;
      lastTime = time;

      // кільце: легке запізнення (≈ 35 % відстані за кадр)
      const nx = x + (tx - x) * 0.35;
      const ny = y + (ty - y) * 0.35;
      const vx = nx - x;
      const vy = ny - y;
      x = nx;
      y = ny;
      ring.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      const speed = Math.hypot(vx, vy);
      if (speed > 0.4) {
        // напрямок згладжуємо, щоб віяло не смикалось
        dirX += (vx / speed - dirX) * 0.2;
        dirY += (vy / speed - dirY) * 0.2;
        const n = Math.hypot(dirX, dirY) || 1;
        dirX /= n;
        dirY /= n;
      }

      const moving = time - lastMove < 80;
      ring.classList.toggle('is-idle', !moving && speed < 0.3);

      // щупальця: з'являються під час руху, тануть за FADE_OUT після зупинки
      if (allowed() && moving) fade = Math.min(1, fade + dt / 120);
      else fade = Math.max(0, fade - dt / FADE_OUT);

      if (fade > 0) follow();
      draw(time);

      raf = fade > 0 || speed > 0.3 || moving ? requestAnimationFrame(tick) : 0;
      if (!raf) lastTime = 0;
    };

    const start = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse' || !finePointer.matches) return;
        tx = e.clientX;
        ty = e.clientY;
        lastMove = performance.now();
        if (!placed || reduceMotion.matches) {
          x = tx;
          y = ty;
          ring.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        }
        if (!placed || fade <= 0) resetTentacles();
        placed = true;
        visible = true;
        ring.classList.add('is-visible');

        const target = e.target instanceof Element ? e.target : null;
        hover = !!target?.closest(INTERACTIVE);
        ring.classList.toggle('is-hover', hover);
        overHero = !!target?.closest('[data-hero]');
        start();
      },
      { passive: true },
    );

    // курсор вийшов за межі вікна — ховаємо кільце; щупальця тануть самі
    document.documentElement.addEventListener('mouseleave', () => {
      visible = false;
      ring.classList.remove('is-visible', 'is-idle');
      start();
    });

    window.addEventListener('lindigo:menu', (e) => {
      menuOpen = !!(e as CustomEvent<{ open: boolean }>).detail?.open;
      start();
    });

    // тема змінилась — нові кольори щупалець
    new MutationObserver(readColors).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    window.addEventListener('resize', resize);
    readColors();
    resize();
    // кільце, що щойно з'явилось і стоїть, теж «дихає»
    ring.classList.add('is-idle');
  }
</script>
