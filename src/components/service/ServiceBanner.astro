---
/**
 * Банер сторінки послуги: заголовок (H5), опис і кнопка поруч (Figma, банер «Сайти під ключ», 24.11.2026).
 * Темна — скло, світла — Orchid dark (--banner-bg).
 * Де стоїть: калькулятор під картками цін (головна кнопка) і «Сайти під ключ» у кінці блоку
 * «Коли потрібен…» (контурна кнопка, спокійніше — рішення Яни 24.11.2026).
 * align="center" — усе по центру, кнопка під текстом (банер калькулятора): немає порожнього правого краю
 * на широких екранах, кнопка лишається поруч із текстом, банер читається як пауза (рішення Яни 24.11.2026).
 */
import Button from '../Button.astro';
import { keepLastWords } from '../../i18n/ui';

interface Props {
  /** id заголовка (aria-labelledby) — унікальний на сторінці */
  id: string;
  content: { title: string; text: string; action: string };
  href: string;
  variant?: 'primary' | 'secondary';
  /** start — текст ліворуч, кнопка поруч; center — усе по центру, кнопка під текстом */
  align?: 'start' | 'center';
}

const { id, content: t, href, variant = 'primary', align = 'start' } = Astro.props;
---

<aside class:list={['banner', { 'banner--center': align === 'center' }]} aria-labelledby={id}>
  <div class="banner__text">
    <h3 class="banner__title" id={id}>{t.title}</h3>
    <p class="banner__desc">{keepLastWords(t.text)}</p>
  </div>
  <Button href={href} variant={variant}>{t.action}</Button>
</aside>

<style>
  .banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-24);
    padding: var(--space-32);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-32);
    background: var(--banner-bg);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  .banner__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .banner__title {
    font-family: var(--font-display);
    font-weight: var(--text-h5--font-weight);
    font-size: var(--text-h5);
    line-height: var(--text-h5--line-height);
  }

  .banner__desc {
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
  }

  /* По центру: текст у два-три рядки, кнопка під ним; більші поля зверху й знизу — пауза між блоками */
  .banner--center {
    flex-direction: column;
    gap: var(--space-32);
    padding: var(--space-56) var(--space-32);
    text-align: center;
  }
  /* заголовок і опис — кожен в один рядок; на вужчих екранах переносяться рівними рядками */
  .banner--center .banner__text {
    align-items: center;
  }
  .banner--center .banner__desc {
    text-wrap: balance;
  }

  /* Телефон */
  @media (max-width: 640px) {
    .banner {
      padding: var(--space-24);
      border-radius: var(--radius-24);
    }
    .banner--center {
      gap: var(--space-24);
      padding: var(--space-40) var(--space-24);
    }
    .banner :global(.btn) {
      width: 100%;
      height: 50px;
    }
  }
</style>
