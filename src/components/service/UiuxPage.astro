---
/**
 * Сторінка послуги «UI/UX дизайн і прототипування» (Figma «UI дизайн»: темна 231:3260, світла 243:866).
 * Блоки: перший екран, біжучі рядки (послуги й сфери), «Коли потрібен», «Наші проєкти», «Етапи і результат» (спільний Process),
 * «Скільки коштує», FAQ і «Заклик до дії» (спільні Faq і Cta з текстами сторінки), футер.
 */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Menu from '../Menu.astro';
import Process from '../Process.astro';
import Faq from '../Faq.astro';
import Cta from '../Cta.astro';
import Footer from '../Footer.astro';
import ServiceHero from './ServiceHero.astro';
import ServiceMarquee from './ServiceMarquee.astro';
import ServiceAudience from './ServiceAudience.astro';
import ServiceProjects from './ServiceProjects.astro';
import ServicePricing from './ServicePricing.astro';
// темна: dark-vertical, повернута на 270° (як у Figma: заливка з rotation 270)
import heroDark from '../../assets/backgrounds/service-dark.jpg';
import heroLight from '../../assets/backgrounds/service-light.jpg';
import { localePath, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].uiux;
const path = '/services/ui-ux/';
---

<Base locale={locale} title={t.meta.title} description={t.hero.lead} path={path}>
  <Header locale={locale} path={path} />
  <Menu locale={locale} path={path} />
  <main>
    <ServiceHero locale={locale} content={t.hero} bgDark={heroDark} bgLight={heroLight} worksHref="#projects" cardLabel={t.hero.cardLabel} />
    <ServiceMarquee services={t.hero.tags} servicesLabel={t.hero.tagsLabel} industries={t.hero.industries} industriesLabel={t.hero.industriesLabel} />
    <ServiceAudience content={t.audience} bannerHref={localePath(locale, '/services/sites/')} />
    <ServiceProjects locale={locale} id="projects" />
    <Process locale={locale} content={t.stages} />
    <ServicePricing locale={locale} content={t.pricing} calcHref={`${localePath(locale, '/calculator/')}?service=uiux`} />
    <Faq locale={locale} content={t.faq} />
    <Cta locale={locale} content={t.cta} />
  </main>
  <Footer locale={locale} path={path} />
</Base>
