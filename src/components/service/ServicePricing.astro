---
/**
 * Блок «05 Скільки коштує» сторінки послуги (Figma 231:3696 темна, 243:1100 світла).
 * Три картки цін: назва (H4) і для кого, ціна «від … € HT» (H3), лінія, що входить у стартову ціну,
 * кнопка внизу на всю ширину. Під картками — пояснення й дрібний текст про податки; далі банер
 * калькулятора з головною кнопкою (ServiceBanner). Банер «Сайти під ключ» — у блоці «Коли потрібен…».
 * Картки суцільні, кожна свого кольору: --plan-1-bg … --plan-3-bg (Figma, 24.11.2026).
 * Фон: темна — --section-bg без картинки; світла — --bg і directions-light 20 % на весь блок.
 */
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import ServiceBanner from './ServiceBanner.astro';
import bgLight from '../../assets/backgrounds/directions-light.jpg';
import { keepLastWords, localePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  content: {
    eyebrow: string;
    title: string;
    lead: string;
    includedLabel: string;
    from: string;
    tax: string;
    plans: { title: string; for: string; price: string; items: string[]; action: string }[];
    notes: string[];
    /** Банер калькулятора під картками (такий самий, як банер «Сайти під ключ») */
    calcBanner?: { title: string; text: string; action: string };
    small: string;
  };
  /** Калькулятор з обраним напрямом (напр. /calculator/?service=uiux) */
  calcHref?: string;
}

const { locale, content: t, calcHref } = Astro.props;
---

<section class:list={['pricing', { 'pricing--banner': calcHref && t.calcBanner }]} aria-labelledby="pricing-title">
  <div class="pricing__bg" aria-hidden="true" data-theme-only="light">
    <Image src={bgLight} alt="" widths={[960, 1600, 2048, 2752]} sizes="100vw" loading="lazy" />
  </div>

  <header class="pricing__head">
    <p class="pricing__eyebrow">{t.eyebrow}</p>
    <h2 class="pricing__title" id="pricing-title">{t.title}</h2>
    <p class="pricing__lead">{keepLastWords(t.lead)}</p>
  </header>

  <div class="pricing__body">
    <ul class="pricing__plans" data-reveal-row data-reveal-at="0.75">
      {
        t.plans.map((plan) => (
          <li class="plan">
            <div class="plan__content">
              <div class="plan__head">
                <h3 class="plan__title">{plan.title}</h3>
                <p class="plan__for">{keepLastWords(plan.for)}</p>
              </div>
              <p class="plan__price">
                <span class="plan__from">{t.from}</span>
                <span class="plan__amount">{plan.price}</span>
                <span class="plan__tax">{t.tax}</span>
              </p>
              <div class="plan__rule" />
              <div class="plan__included">
                <p class="plan__label">{t.includedLabel}</p>
                <ul class="plan__items">
                  {plan.items.map((item) => <li>{keepLastWords(item)}</li>)}
                </ul>
              </div>
            </div>
            <Button href={localePath(locale, '/contact/')} variant="secondary" class="plan__action">
              {plan.action}
            </Button>
          </li>
        ))
      }
    </ul>

    <div class="pricing__notes">
      {t.notes.map((note) => <p>{keepLastWords(note)}</p>)}
      <p class="pricing__small">{keepLastWords(t.small)}</p>
    </div>
  </div>

  <!-- Банер калькулятора під картками (рішення Яни 24.11.2026) -->
  {calcHref && t.calcBanner && <ServiceBanner id="pricing-calc-title" content={t.calcBanner} href={calcHref} align="center" />}
</section>

<style>
  .pricing {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
    overflow: hidden;
  }

  /* Світла тема: фон на beige-50 (--bg), картинка 20 % на весь блок */
  :global(:root[data-theme='light']) .pricing {
    background: var(--bg);
  }

  .pricing__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .pricing__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }

  .pricing__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .pricing__eyebrow,
  .plan__tax,
  .plan__label {
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .pricing__title {
    font-family: var(--font-display);
    font-weight: var(--text-h2--font-weight);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
  }

  .pricing__lead {
    font-size: var(--text-body-l);
    line-height: var(--text-body-l--line-height);
  }

  /* між картками й поясненням під ними 40 (рішення Яни 24.11.2026; у макеті 24) */
  .pricing__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
  }

  /* Поява карток коротша за типову: 1 с, кожна наступна на 0,2 с пізніше,
     запуск, коли верх ряду на 75 % екрана (рішення Яни 24.11.2026) */
  .pricing__plans {
    --reveal-duration: 1s;
    --reveal-stagger: 0.2s;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Картка ціни: суцільна, радіус 32, поля 32; кнопка притиснута донизу */
  .plan {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    padding: var(--space-32);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-32);
    background: var(--plan-1-bg);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  .plan:nth-child(2) {
    background: var(--plan-2-bg);
  }

  .plan:nth-child(3) {
    background: var(--plan-3-bg);
  }

  .plan__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* Назва й «для кого» однакової висоти в усіх картках: 124 px на макеті */
  .plan__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-height: 124px;
  }

  .plan__title {
    font-family: var(--font-display);
    font-weight: var(--text-h4--font-weight);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
  }

  .plan__for {
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-8);
  }

  .plan__from {
    font-size: var(--text-body-l);
    line-height: var(--text-body-l--line-height);
  }

  .plan__amount {
    font-family: var(--font-display);
    font-weight: var(--text-h3--font-weight);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    white-space: nowrap;
  }

  .plan__rule {
    height: 1px;
    background: var(--fg);
  }

  .plan__included {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .plan__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin: 0;
    padding-left: var(--space-20);
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
  }

  .plan :global(.plan__action) {
    width: 100%;
  }

  /* Пояснення під картками: не ширше 760 px, щоб читалось за 2–3 рядки (рішення Яни 24.11.2026) */
  .pricing__notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: 760px;
    font-size: var(--text-body-m);
    line-height: var(--text-body-m--line-height);
  }

  /* Юридична примітка про TVA: Body/S, приглушений колір */
  .pricing__notes .pricing__small {
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .pricing__plans {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan__head {
      min-height: 0;
    }
  }

  /* Знизу 56: блок закінчується банером калькулятора, далі FAQ зі своїми 120 згори (рішення Яни 24.11.2026).
     На телефоні й так 56 */
  .pricing--banner {
    padding-bottom: var(--space-56);
  }

  /* Телефон */
  @media (max-width: 640px) {
    .pricing {
      gap: var(--space-24);
      padding: var(--space-56) var(--space-20);
    }
    .pricing__title {
      font-size: var(--text-h2-mobile);
      line-height: var(--text-h2-mobile--line-height);
    }
    .pricing__lead {
      font-size: var(--text-body-m);
      line-height: var(--text-body-m--line-height);
    }
    .plan {
      gap: var(--space-24);
      padding: var(--space-24);
      border-radius: var(--radius-24);
    }
    .plan__title {
      font-size: var(--text-h4-mobile);
      line-height: var(--text-h4-mobile--line-height);
    }
  }
</style>

<script>
  // Картки цін з'являються по черзі зліва направо (спільний ефект, стилі в global.css)
  import '../../scripts/reveal-row';
</script>
