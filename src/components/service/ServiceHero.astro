---
/**
 * Перший екран сторінки послуги (Figma «UI дизайн», «Послуга: UI/UX дизайн і прототипування — UI»,
 * темна 231:3261 і світла 243:867).
 * Фон (Figma, 24.11.2026): темна — Background dark (--night, оновлено 24.11.2026) і градієнт 40 %; світла — світлий градієнт 50 % Multiply.
 * Ліворуч: хлібні крихти, заголовок (Display 72), опис і дві кнопки (теги — у ServiceMarquee під екраном); праворуч — картка проєкту
 * (спільний WorkCard, ширша, ніж на головній, зі своїм підписом). Текст і картка притиснуті донизу.
 * Фарба від мишки над фоном — спільний HeroPaint (на перших екранах усіх сторінок, крім головної).
 * Сторінка «Послуги»: замість картки проєкту — картинка праворуч (слот aside), одна кнопка, крихти «Головна / Послуги».
 */
import { Image } from 'astro:assets';
import Breath from '../Breath.astro';
import Button from '../Button.astro';
import HeroPaint from '../HeroPaint.astro';
import WorkCard from '../WorkCard.astro';
import { featuredWorks } from '../../data/featured';
import { keepLastWords, localePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  content: {
    crumbs: string[];
    crumbsLabel: string;
    title: string;
    lead: string;
    tags: string[];
    primary: string;
    /** Друга кнопка (контурна); без неї — лише «Обговорити проєкт» */
    secondary?: string;
  };
  bgDark: ImageMetadata;
  bgLight: ImageMetadata;
  /** Куди веде «Переглянути роботи» (якір блоку робіт на цій сторінці) */
  worksHref?: string;
  /** Куди веде перша хлібна крихта (за замовчуванням — «Послуги») */
  crumbsHref?: string;
  /** Підпис на картці проєкту (напр. «Проєкт з UI/UX») */
  cardLabel?: string;
}

const { locale, content: t, bgDark, bgLight, worksHref, cardLabel, crumbsHref = '/services/' } = Astro.props;
const aside = Astro.slots.has('aside');
const bgWidths = [768, 1280, 1920, 2752];
---

<section class:list={['s-hero', { 's-hero--card': !aside }]} aria-labelledby="s-hero-title">
  <div class="s-hero__bg" aria-hidden="true">
    <Image class="s-hero__bg-dark" src={bgDark} alt="" widths={bgWidths.filter((w) => w <= bgDark.width)} sizes="100vw" loading="eager" fetchpriority="high" data-theme-only="dark" />
    <Image class="s-hero__bg-light" src={bgLight} alt="" widths={bgWidths.filter((w) => w <= bgLight.width)} sizes="100vw" loading="lazy" data-theme-only="light" />
  </div>
  <!-- плями, що пливуть праворуч (пробний варіант для сторінок послуг); після фону — лежать над ним -->
  <Breath variant="service" />
  <HeroPaint />

  <div class="s-hero__content">
    <div class="s-hero__text">
      <div class="s-hero__heading">
        <nav class="s-hero__crumbs" aria-label={t.crumbsLabel}>
          <ol>
            <li><a href={localePath(locale, crumbsHref)}>{t.crumbs[0]}</a></li>
            <li aria-current="page">{t.crumbs[1]}</li>
          </ol>
        </nav>
        <h1 class="s-hero__title" id="s-hero-title">{t.title}</h1>
      </div>

      <p class="s-hero__lead">{keepLastWords(t.lead)}</p>

      <!-- теги послуги не тут, а в біжучому рядку під першим екраном (ServiceMarquee; рішення Яни 24.11.2026) -->
      <div class="s-hero__actions">
        <Button href={localePath(locale, '/contact/')} variant="primary">{t.primary}</Button>
        {t.secondary && worksHref && <Button href={worksHref} variant="secondary">{t.secondary}</Button>}
      </div>
    </div>

    {
      aside ? (
        <div class="s-hero__aside">
          <slot name="aside" />
        </div>
      ) : (
        <WorkCard locale={locale} works={featuredWorks} label={cardLabel} />
      )
    }
  </div>
</section>

<style>
  .s-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    /* місце під шапку, як у першому екрані головної: 16 + 82 + 16 + 24 */
    padding-top: 136px;
    /* знизу 120 на ноутбуці (рішення Яни 24.11.2026); планшет 48, телефон 32 */
    padding-bottom: var(--space-120);
    overflow: hidden;
    background: var(--night);
  }

  :global(:root[data-theme='light']) .s-hero {
    background: var(--bg);
  }

  /* Великі екрани (ширші за ноутбук 1512): відступ знизу росте разом з екраном і на 1920+ сягає 160 px,
     але не менший за 120; ноутбук не змінюється. */
  @media (min-width: 1600px) {
    .s-hero {
      padding-bottom: clamp(var(--space-120), calc(64px + (100vw - 1600px) * 0.3), 160px);
    }
    /* картка росте разом з екраном, як на головній; .s-hero попереду: базові правила стоять нижче у файлі */
    .s-hero .s-hero__content > :global(.work-card) {
      width: min(460px, 25.93vw);
    }
  }

  /* Перший екран — на всю висоту вікна і на великому моніторі (рішення Яни 26.11.2026; раніше було не більше 960) */

  /* Великий екран (від 1600): заголовок 92 (--text-h1-xl), опис 28 (Body XL), ширина опису — пропорційно
     (665 × 28 / 20 = 931), щоб рядки не стали короткими. Ноутбук, планшет і телефон — без змін (рішення Яни 26.11.2026) */
  @media (min-width: 1600px) {
    .s-hero .s-hero__title {
      font-size: var(--text-h1-xl);
      line-height: var(--text-h1-xl--line-height);
    }
    .s-hero .s-hero__lead {
      max-width: 931px;
      font-size: var(--text-body-xl);
      line-height: var(--text-body-xl--line-height);
    }
  }
  /* З карткою проєкту (UI/UX) довгий заголовок не вміщається в 3 рядки поруч із карткою при 92 до ~1780 px
     (французький рядок «d’Applications et de» — 1130 px): до 1780 лишаємо 72, як на ноутбуці (26.11.2026) */
  @media (min-width: 1600px) and (max-width: 1779px) {
    .s-hero.s-hero--card .s-hero__title {
      font-size: var(--text-display);
      line-height: var(--text-display--line-height);
    }
  }

  /* від 1920 — заголовок 100 */
  @media (min-width: 1920px) {
    .s-hero .s-hero__title {
      font-size: var(--text-h1-2xl);
      line-height: var(--text-h1-2xl--line-height);
    }
  }

  /* Низ першого екрана плавно переходить у фон наступного блоку (стрічки, «Для кого»): без різкої межі
     між фото/плямами першого екрана й рівним фоном. Над фоном, плямами й фарбою, під текстом */
  .s-hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: var(--space-120);
    background: linear-gradient(to bottom, transparent, var(--section-bg));
    pointer-events: none;
  }

  .s-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .s-hero__bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .s-hero__bg :global(.s-hero__bg-dark) {
    opacity: 0.4;
  }

  .s-hero__bg :global(.s-hero__bg-light) {
    opacity: 0.5;
    mix-blend-mode: multiply;
  }

  .s-hero__content {
    display: flex;
    align-items: flex-end;
    gap: var(--space-24);
    padding-inline: var(--gutter);
  }

  .s-hero__text {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-40);
  }

  .s-hero__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* Хлібні крихти: Label/S Caps, колір акценту */
  .s-hero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* риска в кінці пункту, щоб при переносі не починала новий рядок */
  .s-hero__crumbs li:not(:last-child)::after {
    content: '/';
    padding-inline: var(--space-8);
  }

  .s-hero__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .s-hero__crumbs a:hover {
      text-decoration: underline;
    }
  }
  .s-hero__crumbs a:focus-visible {
    text-decoration: underline;
  }

  /* Заголовок завжди у 3 рядки (рішення Яни 24.11.2026): ширина 12,5 em ламає його однаково на будь-якому екрані —
     «Design UI/UX / d’applications et de / plateformes web». Display 72; на вужчих ноутбуках H2 56, щоб 12,5 em уміщалися */
  .s-hero__title {
    max-width: 12.5em;
    font-family: var(--font-display);
    font-weight: var(--text-display--font-weight);
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
  }
  @media (min-width: 1101px) and (max-width: 1479px) {
    .s-hero__title {
      font-size: var(--text-h2);
      line-height: var(--text-h2--line-height);
    }
  }

  .s-hero__lead {
    max-width: 665px;
    font-size: var(--text-body-lead);
    line-height: var(--text-body-lead--line-height);
  }

  .s-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  /* Картка проєкту такого ж розміру, як на головній (392 px на 1512) — більше місця заголовку (рішення Яни 24.11.2026);
     обкладинка — пропорція --aspect-work-card, як на головній */
  .s-hero__content > :global(.work-card) {
    flex-shrink: 0;
    width: min(392px, 25.93vw);
    margin-left: auto;
  }
  /* Хмара → медуза праворуч замість картки (сторінка «Послуги»): вертикальний кадр 9 : 16, притиснутий донизу першого екрана,
     більший, ніж у макеті (рішення Яни 25.11.2026). Росте з висотою вікна (26.11.2026): ширина — не більша за 720 px,
     40 % ширини екрана і стільки, щоб уся висота (ширина / 0,5625) вміщалась під шапкою. На ноутбуці 1512 × 982 — 485 px, як було */
  .s-hero__aside {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    width: min(720px, 40vw, calc((100svh - var(--space-120)) * 0.5625));
  }
  @media (max-width: 1100px) {
    .s-hero__aside {
      position: relative;
      right: auto;
      order: -1;
      width: min(320px, 50%);
      margin-inline: auto;
    }
  }
  @media (max-width: 640px) {
    .s-hero__aside {
      width: min(240px, 70%);
    }
  }

  /* Вужчий екран: картка під текстом */
  @media (max-width: 1100px) {
    /* планшет: відступ знизу 48, як на головній (120 тільки для ноутбука; рішення Яни 24.11.2026) */
    .s-hero {
      justify-content: flex-end;
      padding-bottom: var(--space-48);
    }
    .s-hero__content {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-48);
    }
    .s-hero__text {
      max-width: none;
    }
    /* 7 vw: на планшеті 834 заголовок уміщається в 3 рядки */
    .s-hero__title {
      font-size: clamp(1.875rem, 7vw, 4.5rem);
    }
    /* планшет: картка на всю ширину між полями (рішення Яни 23.11.2026) */
    .s-hero__content > :global(.work-card) {
      width: 100%;
      margin-left: 0;
    }
  }

  /* Телефон */
  @media (max-width: 640px) {
    /* На телефоні хлібних крихт немає (правило Яни 24.11.2026): екран і так завантажений,
       а назад ведуть меню й кнопка браузера. display: none — щоб посилання не ловило фокус невидимим */
    .s-hero__crumbs {
      display: none;
    }
    .s-hero {
      padding-top: 112px;
      padding-bottom: var(--space-32);
    }
    .s-hero__content {
      gap: var(--space-32);
      padding-inline: var(--space-20);
    }
    .s-hero__text {
      gap: var(--space-24);
    }
    .s-hero__title {
      font-size: var(--text-h1-mobile);
      line-height: var(--text-h1-mobile--line-height);
    }
    .s-hero__lead {
      font-size: var(--text-body-m);
      line-height: var(--text-body-m--line-height);
    }
    .s-hero__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .s-hero__actions :global(.btn) {
      height: 50px;
    }
    .s-hero__content > :global(.work-card) {
      width: 100%;
    }
  }
</style>
