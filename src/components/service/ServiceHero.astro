---
/**
 * Перший екран сторінки послуги (Figma «UI дизайн», «Послуга: UI/UX дизайн і прототипування — UI»,
 * темна 231:3261 і світла 243:867).
 * Фон (Figma, 24.11.2026): темна — Background dark (--night, оновлено 24.11.2026) і градієнт 40 %; світла — світлий градієнт 50 % Multiply.
 * Ліворуч: хлібні крихти, заголовок (Display 72), опис, теги й дві кнопки; праворуч — картка проєкту
 * (спільний WorkCard, ширша, ніж на головній, зі своїм підписом). Текст і картка притиснуті донизу.
 */
import { Image } from 'astro:assets';
import Breath from '../Breath.astro';
import Button from '../Button.astro';
import WorkCard from '../WorkCard.astro';
import { featuredWorks } from '../../data/featured';
import { keepLastWords, localePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  content: {
    crumbs: string[];
    crumbsLabel: string;
    title: string;
    lead: string;
    tags: string[];
    primary: string;
    secondary: string;
  };
  bgDark: ImageMetadata;
  bgLight: ImageMetadata;
  /** Куди веде «Переглянути роботи» (якір блоку робіт на цій сторінці) */
  worksHref: string;
  /** Підпис на картці проєкту (напр. «Проєкт з UI/UX») */
  cardLabel?: string;
}

const { locale, content: t, bgDark, bgLight, worksHref, cardLabel } = Astro.props;
const bgWidths = [768, 1280, 1920, 2752];
---

<section class="s-hero" aria-labelledby="s-hero-title">
  <div class="s-hero__bg" aria-hidden="true">
    <Image class="s-hero__bg-dark" src={bgDark} alt="" widths={bgWidths.filter((w) => w <= bgDark.width)} sizes="100vw" loading="eager" fetchpriority="high" data-theme-only="dark" />
    <Image class="s-hero__bg-light" src={bgLight} alt="" widths={bgWidths.filter((w) => w <= bgLight.width)} sizes="100vw" loading="lazy" data-theme-only="light" />
  </div>
  <!-- плями, що пливуть праворуч (пробний варіант для сторінок послуг); після фону — лежать над ним -->
  <Breath variant="service" />

  <div class="s-hero__content">
    <div class="s-hero__text">
      <div class="s-hero__heading">
        <nav class="s-hero__crumbs" aria-label={t.crumbsLabel}>
          <ol>
            <li><a href={localePath(locale, '/services/')}>{t.crumbs[0]}</a></li>
            <li aria-current="page">{t.crumbs[1]}</li>
          </ol>
        </nav>
        <h1 class="s-hero__title" id="s-hero-title">{t.title}</h1>
      </div>

      <p class="s-hero__lead">{keepLastWords(t.lead)}</p>

      <div class="s-hero__bottom">
        <ul class="s-hero__tags">
          {t.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <div class="s-hero__actions">
          <Button href={localePath(locale, '/contact/')} variant="primary">{t.primary}</Button>
          <Button href={worksHref} variant="secondary">{t.secondary}</Button>
        </div>
      </div>
    </div>

    <WorkCard locale={locale} works={featuredWorks} label={cardLabel} />
  </div>
</section>

<style>
  .s-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    /* місце під шапку, як у першому екрані головної: 16 + 82 + 16 + 24 */
    padding-top: 136px;
    padding-bottom: var(--space-64);
    overflow: hidden;
    background: var(--night);
  }

  :global(:root[data-theme='light']) .s-hero {
    background: var(--bg);
  }

  /* Великі екрани (ширші за ноутбук 1512): відступ знизу як у першому екрані головної —
     від 1600 px росте разом з екраном і на 1920+ сягає 160 px; ноутбук не змінюється. */
  @media (min-width: 1600px) {
    .s-hero {
      padding-bottom: min(160px, calc(64px + (100vw - 1600px) * 0.3));
    }
    /* вміст більшає разом з екраном: заголовок як на головній (H1 86), ширші текст і картка */
    /* .s-hero попереду: базові правила стоять нижче у файлі */
    .s-hero .s-hero__text {
      max-width: 920px;
    }
    .s-hero .s-hero__title {
      font-size: var(--text-h1);
      line-height: var(--text-h1--line-height);
    }
    .s-hero .s-hero__content > :global(.work-card) {
      width: min(680px, 36.38vw);
    }
  }

  /* Високе вікно (великий монітор): висота першого екрана не більша, ніж на ноутбуці (960),
     вміст притиснутий донизу, як на ноутбуці — інакше над текстом забагато порожнечі (рішення Яни 23.11.2026) */
  @media (min-width: 1101px) {
    .s-hero {
      min-height: min(100svh, 960px);
    }
  }

  .s-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .s-hero__bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .s-hero__bg :global(.s-hero__bg-dark) {
    opacity: 0.4;
  }

  .s-hero__bg :global(.s-hero__bg-light) {
    opacity: 0.5;
    mix-blend-mode: multiply;
  }

  .s-hero__content {
    display: flex;
    align-items: flex-end;
    gap: var(--space-24);
    padding-inline: var(--gutter);
  }

  .s-hero__text {
    flex: 1 1 0;
    min-width: 0;
    max-width: 778px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-40);
  }

  .s-hero__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* Хлібні крихти: Label/S Caps, колір акценту */
  .s-hero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-weight: var(--text-label-s--font-weight);
    font-size: var(--text-label-s);
    line-height: var(--text-label-s--line-height);
    letter-spacing: var(--text-label-s--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* риска в кінці пункту, щоб при переносі не починала новий рядок */
  .s-hero__crumbs li:not(:last-child)::after {
    content: '/';
    padding-inline: var(--space-8);
  }

  .s-hero__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .s-hero__crumbs a:hover {
      text-decoration: underline;
    }
  }
  .s-hero__crumbs a:focus-visible {
    text-decoration: underline;
  }

  .s-hero__title {
    font-family: var(--font-display);
    font-weight: var(--text-display--font-weight);
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
  }

  .s-hero__lead {
    max-width: 665px;
    font-size: var(--text-body-lead);
    line-height: var(--text-body-lead--line-height);
  }

  .s-hero__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  .s-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s-hero__tags li {
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--fg);
    border-radius: var(--radius-20);
    font-size: var(--text-body-s);
    line-height: var(--text-body-s--line-height);
  }

  .s-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  /* Картка проєкту: 550 px на макеті 1512; обкладинка — пропорція --aspect-work-card, як на головній */
  .s-hero__content > :global(.work-card) {
    flex-shrink: 0;
    width: min(550px, 36.38vw);
    margin-left: auto;
  }
  /* Вужчий екран: картка під текстом */
  @media (max-width: 1100px) {
    .s-hero {
      justify-content: flex-end;
    }
    .s-hero__content {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-48);
    }
    .s-hero__text {
      max-width: none;
    }
    .s-hero__title {
      font-size: clamp(1.875rem, 7.2vw, 4.5rem);
    }
    /* планшет: картка на всю ширину між полями (рішення Яни 23.11.2026) */
    .s-hero__content > :global(.work-card) {
      width: 100%;
      margin-left: 0;
    }
  }

  /* Телефон */
  @media (max-width: 640px) {
    .s-hero {
      padding-top: 112px;
      padding-bottom: var(--space-32);
    }
    .s-hero__content {
      gap: var(--space-32);
      padding-inline: var(--space-20);
    }
    .s-hero__text {
      gap: var(--space-24);
    }
    .s-hero__title {
      font-size: var(--text-h1-mobile);
      line-height: var(--text-h1-mobile--line-height);
    }
    .s-hero__lead {
      font-size: var(--text-body-m);
      line-height: var(--text-body-m--line-height);
    }
    .s-hero__bottom {
      gap: var(--space-32);
      width: 100%;
    }
    .s-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .s-hero__actions :global(.btn) {
      height: 50px;
    }
    .s-hero__content > :global(.work-card) {
      width: 100%;
    }
  }
</style>
