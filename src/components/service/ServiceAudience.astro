---
/**
 * Блок «02 Коли потрібен…» сторінки послуги (Figma 231:3345 темна, 243:914 світла).
 * Мітка, заголовок H2, підзаголовок і три скляні картки: номер, назва (H4), текст.
 * Фон: тільки --section-bg, без картинки; за картками пливе розмита медуза: виринає з-під нижнього лівого кута,
 * пливе хвилею (синусоїдою) вгору праворуч і зникає за правим краєм екрана на рівні заголовка (там, де «UI/UX ?»);
 * до біжучих стрічок над блоком не допливає (рішення Яни 24.11.2026). Потім усе знову.
 * Рух поштовхами, як у справжньої медузи: купол стискається — ривок, далі ковзання (рішення Яни 23.11.2026).
 * Поза екраном і з «менше руху» в системі не рухається.
 */
import { Image } from 'astro:assets';
import jellyDark from '../../assets/faq/jellyfish-dark.webp';
import jellyLight from '../../assets/faq/jellyfish-light-upright.webp';
import ServiceBanner from './ServiceBanner.astro';
import { keepLastWords } from '../../i18n/ui';

interface Props {
  content: {
    eyebrow: string;
    title: string;
    lead: string;
    items: { title: string; text: string }[];
    /** Інший шлях для тих, хто не впізнав себе в картках (напр. «Сайти під ключ») */
    banner?: { title: string; text: string; action: string };
  };
  /** Куди веде кнопка банера */
  bannerHref?: string;
}

const { content: t, bannerHref } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="audience" aria-labelledby="audience-title">
  <div class="audience__bg" aria-hidden="true">
    <!-- шлях: шар на всю секцію зсувається (відсотки — від розміру секції), медуза в його нижньому лівому куті -->
    <div class="audience__track">
      <div class="audience__jelly">
        <Image class="audience__jelly-img" src={jellyDark} alt="" widths={[300, 600]} sizes="300px" loading="lazy" data-theme-only="dark" />
        <Image class="audience__jelly-img" src={jellyLight} alt="" widths={[300, 600]} sizes="300px" loading="lazy" data-theme-only="light" />
      </div>
    </div>
  </div>

  <header class="audience__head">
    <p class="audience__eyebrow">{t.eyebrow}</p>
    <h2 class="audience__title" id="audience-title">{t.title}</h2>
    <p class="audience__lead">{keepLastWords(t.lead)}</p>
  </header>

  <ol class="audience__list" data-reveal-row data-reveal-at="0.85">
    {
      t.items.map((item, i) => (
        <li class="audience__card">
          <div class="audience__card-head">
            <p class="audience__num" aria-hidden="true">{pad(i + 1)}</p>
            <h3 class="audience__card-title">{item.title}</h3>
          </div>
          <p class="audience__text">{keepLastWords(item.text)}</p>
        </li>
      ))
    }
  </ol>

  <!-- У кінці блоку: якщо людина не впізнала своє завдання, показуємо інший шлях; контурна кнопка — спокійніше (рішення Яни 24.11.2026) -->
  {t.banner && bannerHref && <ServiceBanner id="audience-banner-title" content={t.banner} href={bannerHref} variant="secondary" />}
</section>

<style>
  .audience {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
    /* обрізаємо з боків: медуза запливає за правий край */
    overflow-x: clip;
  }

  /* фон з медузою: обрізаний по краях блоку — медуза не запливає на стрічки над ним */
  .audience__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    clip-path: inset(0);
  }

  /* Медуза: пливе куполом уперед, трохи розмита. Шлях за 26 с — 14 поштовхів по 1.86 с:
     кожен відрізок починається ривком і закінчується ковзанням (cubic-bezier), купол стискається на початку
     кожного поштовху. Ключові точки пораховано за синусоїдою (1,5 хвилі): від нижнього лівого кута
     на 110 % ширини праворуч і 112 % висоти вгору; спершу пливе більше вгору, наприкінці — праворуч,
     тож за правий край запливає на рівні заголовка. */
  .audience__track {
    position: absolute;
    inset: 0;
    animation: audience-jelly-path 26s cubic-bezier(0.2, 0.7, 0.35, 1) infinite;
    animation-play-state: paused;
    will-change: translate;
  }

  .audience__jelly {
    position: absolute;
    left: 4%;
    top: 100%;
    width: clamp(150px, 13vw, 260px);
    opacity: 0.65;
    animation: audience-jelly-turn 26s cubic-bezier(0.2, 0.7, 0.35, 1) infinite;
    animation-play-state: inherit;
  }

  :global(:root[data-theme='light']) .audience__jelly {
    opacity: 0.55;
  }

  .audience.is-inview .audience__track {
    animation-play-state: running;
  }

  /* Поки гість на першому екрані, медузи немає: вона вирушає, коли блок піднявся на третину екрана
     (клас is-waiting ставить і знімає скрипт нижче; без JS медуза просто стоїть унизу). Рішення Яни 24.11.2026 */
  .audience.is-waiting .audience__bg {
    visibility: hidden;
  }
  .audience.is-waiting .audience__track {
    animation-play-state: paused;
  }

  .audience__jelly :global(.audience__jelly-img) {
    display: block;
    width: 100%;
    height: auto;
    filter: blur(4px);
    transform-origin: 50% 30%;
    animation: audience-jelly-pulse 1.8571s ease-out infinite;
    animation-play-state: inherit;
  }

  @keyframes audience-jelly-path {
    0.00% { translate: 0.0% -0.0%; }
    7.14% { translate: 5.4% -8.0%; }
    14.29% { translate: 10.7% -16.0%; }
    21.43% { translate: 14.8% -24.0%; }
    28.57% { translate: 17.4% -32.0%; }
    35.71% { translate: 19.8% -40.0%; }
    42.86% { translate: 23.7% -48.0%; }
    50.00% { translate: 30.3% -56.0%; }
    57.14% { translate: 40.2% -64.0%; }
    64.29% { translate: 52.9% -72.0%; }
    71.43% { translate: 66.8% -80.0%; }
    78.57% { translate: 80.2% -88.0%; }
    85.71% { translate: 91.8% -96.0%; }
    92.86% { translate: 101.4% -104.0%; }
    100.00% { translate: 110.0% -112.0%; }
  }

  /* медуза повертається за напрямком хвилі */
  @keyframes audience-jelly-turn {
    0.00% { rotate: 38deg; }
    7.14% { rotate: 47deg; }
    14.29% { rotate: 42deg; }
    21.43% { rotate: 32deg; }
    28.57% { rotate: 23deg; }
    35.71% { rotate: 28deg; }
    42.86% { rotate: 44deg; }
    50.00% { rotate: 58deg; }
    57.14% { rotate: 65deg; }
    64.29% { rotate: 69deg; }
    71.43% { rotate: 69deg; }
    78.57% { rotate: 67deg; }
    85.71% { rotate: 63deg; }
    92.86% { rotate: 59deg; }
    100.00% { rotate: 58deg; }
  }

  /* поштовх: купол стискається й розправляється */
  @keyframes audience-jelly-pulse {
    0% {
      scale: 1 1;
    }
    18% {
      scale: 0.86 1.08;
    }
    100% {
      scale: 1 1;
    }
  }

  /* «Менше руху»: медуза стоїть праворуч і не пливе */
  @media (prefers-reduced-motion: reduce) {
    .audience__track,
    .audience__jelly,
    .audience__jelly :global(.audience__jelly-img) {
      animation: none;
    }
    .audience__track {
      translate: 70% -75%;
    }
    .audience__jelly {
      rotate: 30deg;
    }
  }

  .audience__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .audience__eyebrow,
  .audience__num {
    font-family: var(--font-mono);
    font-weight: var(--text-label-m--font-weight);
    font-size: var(--text-label-m);
    line-height: var(--text-label-m--line-height);
    letter-spacing: var(--text-label-m--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .audience__title {
    font-family: var(--font-display);
    font-weight: var(--text-h2--font-weight);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
  }

  .audience__lead {
    font-size: var(--text-body-l);
    line-height: var(--text-body-l--line-height);
    color: var(--text-soft);
  }

  /* Картки невисокі: з'являються раніше (верх ряду на 85 % екрана) і швидше, ніж ціни
     (0,9 с, кожна наступна на 0,15 с пізніше; рішення Яни 24.11.2026) */
  .audience__list {
    --reveal-duration: 0.9s;
    --reveal-stagger: 0.15s;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Картка: скло, радіус 28, поля 32 */
  .audience__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    padding: var(--space-32);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-28);
    background: var(--card-bg);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }

  .audience__card-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .audience__card-title {
    font-family: var(--font-display);
    font-weight: var(--text-h4--font-weight);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
  }

  .audience__text {
    font-size: var(--text-body-l);
    line-height: var(--text-body-l--line-height);
    color: var(--text-soft);
  }

  @media (max-width: 1100px) {
    .audience__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Телефон */
  @media (max-width: 640px) {
    .audience {
      gap: var(--space-24);
      padding: var(--space-56) var(--space-20);
    }
    .audience__title {
      font-size: var(--text-h2-mobile);
      line-height: var(--text-h2-mobile--line-height);
    }
    .audience__lead,
    .audience__text {
      font-size: var(--text-body-m);
      line-height: var(--text-body-m--line-height);
    }
    .audience__list {
      gap: var(--space-16);
    }
    .audience__card {
      gap: var(--space-16);
      padding: var(--space-24);
      border-radius: var(--radius-24);
    }
    .audience__card-title {
      font-size: var(--text-h4-mobile);
      line-height: var(--text-h4-mobile--line-height);
    }
  }
</style>

<script>
  // Картки з'являються по черзі зліва направо, як картки цін (спільний ефект, стилі в global.css)
  import '../../scripts/reveal-row';

  // Медуза пливе тільки тоді, коли блок на екрані
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.audience').forEach((section) => {
    new IntersectionObserver(([entry]) => section.classList.toggle('is-inview', entry.isIntersecting)).observe(section);
    if (reduce) return; // «менше руху»: медуза стоїть на місці й видна одразу
    // Вирушає з початку шляху, коли верх блоку піднявся вище 65 % висоти екрана
    section.classList.add('is-waiting');
    const start = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        section.classList.remove('is-waiting');
        start.disconnect();
      },
      { rootMargin: '0px 0px -35% 0px' },
    );
    start.observe(section);
  });
</script>
