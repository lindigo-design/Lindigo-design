---
/**
 * Блок «02 Напрями» (Figma «Головна · Варіант 2», темна й світла тема).
 * П'ять карток на скляній підкладці: номер, назва, мітки, опис, «Детальніше» і зображення робіт напряму.
 * Фон блоку — векторні плями, що «дихають» (Breath.astro); кольори зняті з фону Figma.
 *
 * Стопка карток (як у Kota Creative): під час прокрутки заголовок блоку й кожна картка прилипають
 * під шапкою, наступна картка наїжджає знизу; верхні картки видно смужками по 16 px.
 * Те, що накривають, трохи зменшується (до 95 %) і темнішає (заголовок блякне до нуля) — веде скрипт.
 * Лише на комп'ютері й планшеті з достатньою висотою екрана: на телефоні картки вищі за екран.
 */
import { Image } from 'astro:assets';
import Breath from './Breath.astro';
import Button from './Button.astro';
import work1 from '../assets/directions/work-1.jpg';
import work2 from '../assets/directions/work-2.jpg';
import work3 from '../assets/directions/work-3.jpg';
import work4 from '../assets/directions/work-4.jpg';
import work5 from '../assets/directions/work-5.jpg';
import { directionPaths, keepLastWords, localePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].directions;

/**
 * Кадрування як у Figma (рамка фото 605 × 520): яку частину зображення видно (object-position)
 * і наближення (zoom) навколо точки origin — з imageTransform шарів макета.
 */
const media = [
  { src: work1, position: '48.9% 50%', zoom: 1.062, origin: '50% 47.9%' },
  { src: work2, position: '50% 50%' },
  { src: work3, position: '24.4% 50%' },
  { src: work4, position: '50% 50%' },
  { src: work5, position: '50% 50%' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="directions" aria-labelledby="directions-title">
  <Breath variant="directions" />

  <header class="directions__head" data-stack-head>
    <p class="directions__eyebrow">{t.eyebrow}</p>
    <h2 class="directions__title" id="directions-title">{t.title}</h2>
  </header>

  <ol class="directions__list">
    {
      t.items.map((item, i) => (
        <li class="direction" style={`--i: ${i}`} data-stack-card>
          <div class="direction__text">
            <p class="direction__num" aria-hidden="true">{pad(i + 1)}</p>
            <h3 class="direction__title">{item.title}</h3>
            <ul class="direction__tags">
              {item.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <p class="direction__desc">{keepLastWords(item.text)}</p>
            <Button href={localePath(locale, directionPaths[i])} variant="secondary" class="direction__more">
              {t.more}
              <span class="visually-hidden">: {item.title}</span>
            </Button>
          </div>
          <div class="direction__media">
            <Image
              src={media[i].src}
              alt=""
              widths={[480, 800, 1200]}
              sizes="(max-width: 760px) 100vw, 640px"
              style={`object-position: ${media[i].position}` + (media[i].zoom ? `; scale: ${media[i].zoom}; transform-origin: ${media[i].origin}` : '')}
            />
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .directions {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding: 120px var(--gutter);
    background: var(--section-bg);
    /* clip, а не hidden: hidden робить блок контейнером прокрутки, і sticky у картках не працює */
    overflow: clip;
  }


  /* Заголовок блоку: підпис 14 моно, 16 px, назва 56 */
  .directions__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .directions__eyebrow,
  .direction__num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .directions__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 56px;
    line-height: 68px;
  }

  .directions__list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Картка: скло, радіус 32, відступи 32 / 32 / 32 / 48 */
  .direction {
    display: flex;
    align-items: center;
    gap: 48px;
    padding: 32px 32px 32px 48px;
    border: 1px solid var(--card-border);
    border-radius: 32px;
    background: var(--card-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .direction__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    flex: 0 1 617px;
    min-width: 0;
  }

  .direction__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 40px;
    line-height: 48px;
  }

  .direction__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .direction__tags li {
    padding: 8px 16px;
    border: 1px solid var(--tag-border);
    border-radius: 20px;
    font-size: 14px;
    line-height: 20px;
  }

  .direction__desc {
    font-weight: 500;
    font-size: 20px;
    line-height: 30px;
    color: color-mix(in srgb, var(--fg) 90%, transparent);
  }

  /* «Детальніше»: друга кнопка, обводка м'якша (60 % / 48 %), 28 px з боків */
  .direction__text :global(.direction__more) {
    height: 54px;
    padding-inline: 28px;
    border-color: var(--more-border);
  }

  .direction__media {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    /* картка 586 px у макеті: фото 520 + поля 32 + рамка */
    height: 520px;
    overflow: hidden;
    border-radius: 20px;
  }

  .direction__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Стопка карток ---------- */
  @media (min-width: 761px) and (min-height: 760px) {
    .directions__head {
      position: sticky;
      top: 128px;
      transform-origin: 0 0;
    }
    .direction {
      position: sticky;
      /* під шапкою (≈ 104 px) + 24; кожна наступна на 16 px нижче — верхні видно смужками */
      top: calc(128px + var(--i) * 16px);
      transform-origin: 50% 0;
      /* непрозорий фон: скло тих самих кольорів, але картки не просвічують одна крізь одну */
      background: linear-gradient(var(--card-bg), var(--card-bg)), var(--section-bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      will-change: transform;
    }
    /* Затемнення картки, яку накривають (сила — --cover від 0 до 1, задає скрипт) */
    .direction::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      background: var(--section-bg);
      opacity: calc(var(--cover, 0) * 0.45);
      pointer-events: none;
    }
  }

  /* Вужчий комп'ютер і планшет: менші заголовки й відступи */
  @media (max-width: 1100px) {
    .direction {
      gap: 32px;
      padding: 32px;
    }
    /* Текст і зображення — рівні половини */
    .direction__text {
      flex: 1 1 0;
    }
    .direction__media {
      height: 420px;
    }
    .direction__title {
      font-size: 32px;
      line-height: 40px;
    }
    .direction__desc {
      font-size: 18px;
      line-height: 28px;
    }
  }

  /* Картка в стовпчик: текст, під ним зображення на всю ширину (на планшеті 834 ще поруч) */
  @media (max-width: 760px) {
    .direction {
      flex-direction: column;
      align-items: stretch;
    }
    .direction__text {
      flex-basis: auto;
    }
    .direction__media {
      flex: none;
      height: auto;
      aspect-ratio: 16 / 10;
    }
  }

  /* Телефон: відступи й розміри за правилами верстки (план, розділ 10) */
  @media (max-width: 640px) {
    .directions {
      gap: 24px;
      padding: 96px 20px;
    }
    .directions__title {
      font-size: 32px;
      line-height: 40px;
    }
    .direction {
      gap: 24px;
      padding: 24px;
      border-radius: 24px;
    }
    .direction__text {
      gap: 16px;
    }
    .direction__title {
      font-size: 26px;
      line-height: 32px;
    }
    .direction__desc {
      font-size: 16px;
      line-height: 24px;
    }
    .direction__text :global(.direction__more) {
      height: 50px;
    }
    .direction__media {
      border-radius: 16px;
    }
  }
</style>

<script>
  // Стопка: картка, яку накриває наступна, зменшується до 95 % і темнішає
  const head = document.querySelector<HTMLElement>('[data-stack-head]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-stack-card]'));
  const stackMode = window.matchMedia('(min-width: 761px) and (min-height: 760px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let raf = 0;

  const update = () => {
    raf = 0;
    const on = stackMode.matches && !reduceMotion.matches;
    cards.forEach((card, i) => {
      const next = cards[i + 1];
      let p = 0;
      if (on && next) {
        // скільки наступна картка вже накрила цю: 0 — ще внизу, 1 — стала на своє місце
        const stickTop = parseFloat(getComputedStyle(next).top) || 0;
        const dist = next.getBoundingClientRect().top - stickTop;
        p = Math.min(1, Math.max(0, 1 - dist / card.offsetHeight));
      }
      card.style.transform = p ? `scale(${1 - 0.05 * p})` : '';
      card.style.setProperty('--cover', p.toFixed(3));
    });

    // Заголовок блоку: перша картка наїжджає на нього — він блякне й трохи меншає
    if (head && cards[0]) {
      let p = 0;
      if (on) {
        const stickTop = parseFloat(getComputedStyle(cards[0]).top) || 0;
        const dist = cards[0].getBoundingClientRect().top - stickTop;
        // починає блякнути, коли картка підходить до заголовка (висота заголовка + відступ 56)
        p = Math.min(1, Math.max(0, 1 - dist / (head.offsetHeight + 56)));
      }
      head.style.transform = p ? `scale(${1 - 0.05 * p})` : '';
      // повністю згасає: інакше його край видно з-під зменшеної першої картки
      head.style.opacity = p ? String(1 - p) : '';
    }
  };

  const request = () => {
    if (!raf) raf = requestAnimationFrame(update);
  };
  if (cards.length > 1) {
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    stackMode.addEventListener('change', request);
    reduceMotion.addEventListener('change', request);
    update();
  }
</script>
