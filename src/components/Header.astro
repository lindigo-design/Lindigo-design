---
/**
 * Шапка: скляна смуга, прилипає вгорі й їде разом зі сторінкою.
 * Логотип зліва; справа мова, перемикач теми, «Записатися на дзвінок» (друга кнопка) і бургер у колі.
 *  - від 720 px: усе;
 *  - 600–719 px: без кнопки дзвінка (не влазить; вона є в меню бургера);
 *  - до 599 px: лише логотип і бургер, мова й тема — у меню бургера.
 */
import Button from './Button.astro';
import LangMenu from './LangMenu.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import Logo from './Logo.astro';
import { localePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const t = ui[locale].header;
---

<header class="header">
  <div class="header__bar">
    <a class="header__logo" href={localePath(locale)} aria-label={t.home}>
      <Logo />
    </a>

    <div class="header__actions">
      <!-- Мова й тема — одна група, між ними 16 px (Figma, «навігація») -->
      <div class="header__settings">
        <div class="header__lang"><LangMenu locale={locale} path={path} /></div>
        <div class="header__theme"><ThemeSwitch locale={locale} /></div>
      </div>

      <Button href={localePath(locale, '/contact/')} variant="secondary" size="sm" class="header__call">
        {t.bookCall}
      </Button>

      <!-- Наведення як у другої кнопки: спільний клас .ring-hover. data-btn — короткий спалах кільця від дотику -->
      <button
        class="header__burger ring-hover"
        type="button"
        aria-label={t.menu}
        aria-expanded="false"
        aria-controls="menu"
        data-label-open={t.menu}
        data-label-close={ui[locale].menu.close}
        data-menu-open
        data-btn
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: var(--space-16) var(--space-56);
  }

  .header__bar {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
  }

  /* Скло — окремим шаром. Якщо розмиття стоїть на самій смузі, вкладене скло (панель мов)
     розмиває лише вміст смуги, а не сторінку під нею. */
  /* inset 0: скло лежить усередині обводки. З -1px воно (z-index -1 малюється поверх рамки самої смуги)
     накривало обводку, і її не було видно. */
  .header__bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    pointer-events: none;
  }

  .header__logo {
    display: block;
    flex-shrink: 0;
    border-radius: var(--radius-8);
  }

  

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-24);
  }

  .header__burger {
    display: grid;
    place-content: center;
    gap: var(--space-8);
    width: 48px;
    height: 48px;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .header__burger span {
    width: 20px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--dur-btn) var(--ease-out-in);
  }

  /* Власний маленький рух бургера: лінії трохи роз'їжджаються */
  @media (hover: hover) {
    .header__burger:hover span:first-child {
      transform: translateX(-2px);
    }
    .header__burger:hover span:last-child {
      transform: translateX(2px);
    }
  }
  .header__burger:focus-visible span:first-child {
    transform: translateX(-2px);
  }
  .header__burger:focus-visible span:last-child {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .header__burger span {
      transition: none;
    }
  }

  /* Меню закривається: бургер з'являється з-під скла вже в стані наведення, без проявлення кільця */
  :global(html.menu-closing) .header__burger,
  :global(html.menu-closing) .header__burger::before,
  :global(html.menu-closing) .header__burger span {
    transition: none !important;
  }

  .header__settings,
  .header__lang,
  .header__theme {
    display: flex;
    align-items: center;
  }

  .header__settings {
    gap: var(--space-16);
  }

  /* Кнопка дзвінка (Figma): заливка акцентом 20 %, обводка акцентом — тепер це вигляд усіх другорядних кнопок (Button.astro).
     Наведення — те саме кільце, що й скрізь. */

  /* Планшет (Figma, 834): зовнішні відступи 24 px */
  @media (max-width: 1199px) {
    .header {
      padding: var(--space-16) var(--space-24);
    }
  }

  /* Кнопка дзвінка не влазить: ховаємо, вона є в меню бургера.
     Межу виміряно для найдовшого підпису («Записатися на дзвінок»), щоб до логотипа лишалось ≥ 24 px.
  */
  @media (max-width: 719px) {
    .header__actions :global(.header__call) {
      display: none;
    }
  }

  /* Телефон (Figma, 390): лише логотип і бургер */
  @media (max-width: 599px) {
    .header {
      padding: var(--space-12);
    }
    .header__bar {
      padding: var(--space-8) var(--space-8) var(--space-8) var(--space-16);
    }
    .header__settings {
      display: none;
    }
  }
</style>
