---
/**
 * Блок «05 Фото-стрічка» (Figma «Головна · Варіант 2», темна й світла тема).
 * Горизонтальна стрічка фото різної висоти (540 / 440 px), вирівняних по центру; стрічка заходить
 * за правий край екрана й гортається вбік (тачпад, палець, клавіатура).
 * Фон: колір теми і м'яка золота пляма 12 % (радіальний градієнт з Figma).
 * Фото 6 і 7 у макеті — заглушки (картинка першого екрана з підписом «ФОТО 6/7»), їх не беремо.
 * Рух (рішення Яни 24.11.2026): перше фото велике (360 × 540), решта менші (300 × 440). Кожні 3,5 с
 * перше зменшується, друге збільшується й стає на його місце, а попереднє переходить у кінець —
 * стрічка йде по колу. Пауза — поки на стрічці курсор чи фокус, поки блок поза екраном або вкладка
 * прихована. Свайп на телефоні й стрілки на клавіатурі гортають вперед і назад.
 * Фото злегка збільшується при наведенні. З «зменшити рух» — звичайна стрічка, яку гортають самі.
 */
import { Image } from 'astro:assets';
import photo1 from '../assets/photos/photo-1.jpg';
import photo2 from '../assets/photos/photo-2.jpg';
import photo3 from '../assets/photos/photo-3.jpg';
import photo4 from '../assets/photos/photo-4.jpg';
import photo5 from '../assets/photos/photo-5.jpg';
import allDark from '../assets/works/all-dark.svg';
import allLight from '../assets/works/all-light.svg';
import { localePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].photos;

/** Порядок і кадрування як у Figma (object-position). Розмір залежить від місця: перше фото велике */
const photos = [
  { src: photo1, pos: '50% 50%' },
  { src: photo3, pos: '39% 50%' },
  { src: photo2, pos: '0% 50%' },
  { src: photo4, pos: '50% 50%' },
  { src: photo5, pos: '50% 50%' },
];
---

<section class="photos" aria-labelledby="photos-title">
  <header class="photos__head">
    <div class="photos__heading">
      <p class="photos__eyebrow">{t.eyebrow}</p>
      <h2 class="photos__title" id="photos-title">{t.title}</h2>
    </div>
    <a class="photos__more" href={localePath(locale, '/services/photo/')}>
      {t.more}
      <span class="photos__more-icon" aria-hidden="true">
        <img src={allDark.src} width="36" height="36" alt="" data-theme-only="dark" />
        <img src={allLight.src} width="36" height="36" alt="" data-theme-only="light" />
      </span>
    </a>
  </header>

  <!-- Стрічка гортається; tabindex — щоб її можна було гортати стрілками з клавіатури -->
  <ul class="photos__strip" aria-label={t.strip} tabindex="0" data-photo-strip>
    {
      photos.map((p) => (
        <li class="photos__item">
          <Image src={p.src} alt="" widths={[360, 720]} sizes="360px" loading="lazy" style={`object-position: ${p.pos}`} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .photos {
    /* як --gutter, але від ширини вікна: --side використовується й у вкладених елементах */
    --side: max(clamp(40px, 5.29vw, 80px), calc((100vw - 1800px) / 2));

    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding: var(--space-120) 0 var(--space-120) var(--side);
    /* Світла тема — чистий фон (макет) */
    background: var(--section-bg-alt);
    overflow: hidden;
  }

  /* Темна тема: світіння «Light» з макета — індиго й помаранч праворуч угорі (група 48 %) */
  :global(:root:not([data-theme='light'])) .photos {
    background:
      radial-gradient(40.97vw 26.88vw at 78.41% 33.67%, rgb(82 48 201 / 0.3) 0%, rgb(82 48 201 / 0.25) 20%, rgb(82 48 201 / 0.17) 40%, rgb(82 48 201 / 0.09) 60%, rgb(82 48 201 / 0.03) 80%, rgb(82 48 201 / 0) 100%),
      radial-gradient(26.52vw 17.56vw at 81.35% 54.73%, rgb(242 99 42 / 0.2) 0%, rgb(242 99 42 / 0.17) 20%, rgb(242 99 42 / 0.12) 40%, rgb(242 99 42 / 0.06) 60%, rgb(242 99 42 / 0.02) 80%, rgb(242 99 42 / 0) 100%),
      var(--section-bg-alt);
  }

  .photos__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-24);
    padding-right: var(--side);
  }

  .photos__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .photos__eyebrow {
    font-family: var(--font-mono);
    font-weight: var(--text-label-m--font-weight);
    font-size: var(--text-label-m);
    line-height: var(--text-label-m--line-height);
    letter-spacing: var(--text-label-m--letter-spacing);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .photos__title {
    font-family: var(--font-display);
    font-weight: var(--text-h2--font-weight);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
  }

  .photos__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    font-weight: var(--text-title-16--font-weight);
    font-size: var(--text-title-16);
    line-height: var(--text-title-16--line-height);
    text-decoration: none;
    border-radius: var(--radius-full);
  }

  .photos__more-icon img {
    display: block;
    transition: transform var(--dur-btn) var(--ease-out-in);
  }

  @media (hover: hover) {
    .photos__more:hover .photos__more-icon img {
      transform: rotate(45deg);
    }
  }
  .photos__more:focus-visible .photos__more-icon img {
    transform: rotate(45deg);
  }

  /* Стрічка: 20 px між фото, по центру по вертикалі, гортається вбік */
  .photos__strip {
    display: flex;
    align-items: center;
    gap: var(--space-20);
    height: 540px;
    margin: 0;
    padding: 0 var(--side) 0 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    border-radius: var(--radius-24) 0 0 var(--radius-24);
  }

  .photos__strip::-webkit-scrollbar {
    display: none;
  }

  /* Розміри фото: звичайне 300 × 440, перше (головне) 360 × 540 */
  .photos__strip {
    --w: 300px;
    --h: 440px;
    --w-big: 360px;
    --h-big: 540px;
  }

  .photos__item {
    flex: 0 0 var(--w);
    height: var(--h);
    overflow: hidden;
    border-radius: var(--radius-24);
    scroll-snap-align: start;
  }

  .photos__item:first-child {
    flex-basis: var(--w-big);
    height: var(--h-big);
  }

  /* ---------- Карусель (класи ставить скрипт) ----------
     is-carousel — стрічка не гортається, рухаються самі фото (зсув --shift).
     has-active — під час кроку велике те фото, що має is-active, а не перше.
     is-moving — плавний перехід розміру й зсуву. */
  .photos__strip.is-carousel {
    overflow: hidden;
    scroll-snap-type: none;
  }
  .photos__strip.is-carousel .photos__item {
    translate: var(--shift, 0px) 0;
  }
  .photos__strip.has-active .photos__item:first-child:not(.is-active) {
    flex-basis: var(--w);
    height: var(--h);
  }
  .photos__strip.has-active .photos__item.is-active {
    flex-basis: var(--w-big);
    height: var(--h-big);
  }
  .photos__item.is-entering {
    animation: photo-enter 0.6s var(--ease-out-in);
  }
  @keyframes photo-enter {
    from {
      opacity: 0;
    }
  }
  .photos__strip.is-moving .photos__item {
    transition:
      translate 0.9s var(--ease-out-in),
      flex-basis 0.9s var(--ease-out-in),
      height 0.9s var(--ease-out-in);
  }

  .photos__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.8s var(--ease-out-in);
  }

  /* Легкий зум при наведенні на фото */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .photos__item:hover :global(img) {
      scale: 1.05;
    }
  }

  /* Телефон: фото менші, пропорції ті самі */
  @media (max-width: 640px) {
    .photos {
      --side: 20px;
      gap: var(--space-24);
      padding-block: var(--space-56);
    }
    .photos__title {
      font-size: 2rem; /* 32px */
      line-height: 125%; /* 40px */
    }
    .photos__strip {
      gap: var(--space-12);
      height: 360px;
      scroll-snap-type: x mandatory;
    }
    /* ті самі пропорції, 0,66 від комп'ютера */
    .photos__strip {
      --w: 198px;
      --h: 290px;
      --w-big: 238px;
      --h-big: 356px;
    }
    .photos__item {
      border-radius: var(--radius-16);
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DELAY = 3500; // скільки стоїть кожне фото, мс
  const DURATION = 900; // тривалість кроку, мс (як transition у стилях)

  document.querySelectorAll<HTMLElement>('[data-photo-strip]').forEach((strip) => {
    if (reduceMotion || strip.children.length < 2) return;
    strip.classList.add('is-carousel');
    let timer = 0;
    let busy = false;
    let onScreen = false;
    let hovered = false;
    let focused = false;

    const items = () => Array.from(strip.children) as HTMLElement[];
    // крок = ширина звичайного фото + проміжок
    const stepSize = () => items()[1].offsetWidth + (parseFloat(getComputedStyle(strip).columnGap) || 0);
    const canRun = () => onScreen && !hovered && !focused && !document.hidden;

    // кінець кроку: без переходу переставляємо фото, вигляд не змінюється
    const finish = (reorder: () => void) =>
      window.setTimeout(() => {
        strip.classList.remove('is-moving');
        reorder();
        items().forEach((it) => it.classList.remove('is-active'));
        strip.classList.remove('has-active');
        strip.style.removeProperty('--shift');
        busy = false;
        schedule();
      }, DURATION);

    // уперед: друге фото росте й їде на місце першого, перше меншає й іде в кінець
    const next = () => {
      if (busy) return;
      busy = true;
      const [first, second] = items();
      const d = stepSize();
      strip.classList.add('has-active', 'is-moving');
      second.classList.add('is-active');
      strip.style.setProperty('--shift', `${-d}px`);
      finish(() => {
        strip.append(first);
        // фото, що пішло в кінець, біля правого краю проявляється, а не вискакує
        first.classList.remove('is-entering');
        void first.offsetWidth;
        first.classList.add('is-entering');
      });
    };

    // назад: останнє фото виїжджає зліва й росте, перше меншає
    const prev = () => {
      if (busy) return;
      busy = true;
      const list = items();
      const first = list[0];
      const last = list[list.length - 1];
      const d = stepSize();
      // підготовка без переходу: перше лишається великим, останнє стоїть малим за лівим краєм
      strip.classList.add('has-active');
      first.classList.add('is-active');
      strip.prepend(last);
      strip.style.setProperty('--shift', `${-d}px`);
      void strip.offsetWidth;
      strip.classList.add('is-moving');
      first.classList.remove('is-active');
      last.classList.add('is-active');
      strip.style.setProperty('--shift', '0px');
      finish(() => {});
    };

    const schedule = () => {
      clearTimeout(timer);
      if (canRun()) timer = window.setTimeout(next, DELAY);
    };

    // свайп на телефоні
    let startX = 0;
    strip.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    strip.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) (dx < 0 ? next : prev)();
    });
    // клавіатура: стрілки, коли стрічка у фокусі
    strip.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
    });

    strip.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovered = true; schedule(); } });
    strip.addEventListener('pointerleave', () => { hovered = false; schedule(); });
    strip.addEventListener('focusin', () => { focused = true; schedule(); });
    strip.addEventListener('focusout', () => { focused = false; schedule(); });
    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; schedule(); }, { threshold: 0.3 }).observe(strip);
  });
</script>
