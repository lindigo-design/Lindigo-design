---
/**
 * Блок «09 Заклик до дії» (Figma «Головна · Варіант 2», темна й світла тема).
 * Панель із радіусом 48: розмита картинка рідини під кольором теми (складено з Figma в одну картинку),
 * заголовок 72, підпис 24 і дві кнопки по центру.
 */
import { Image } from 'astro:assets';
import Breath from './Breath.astro';
// Світла тема (макет): фон-градієнт 70 %, Normal, на орхідеї #dda3f7 — смуга з середини фото, повернута на 180°
import bgLight from '../assets/backgrounds/cta-light.jpg';
// Темна тема (макет): той самий темний градієнт 100 %, смуга 62–80 % висоти фото, поверх #150b2e 50 %
import bgDark from '../assets/backgrounds/cta-dark.jpg';
import Button from './Button.astro';
import { keepLastWords, localePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].cta;
const menu = ui[locale].menu;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta__panel">
    <Breath variant="cta" lightImage={bgLight} darkImage={bgDark} />
    <div class="cta__text">
      <h2 class="cta__title" id="cta-title">{t.title}</h2>
      <p class="cta__lead">{keepLastWords(t.text)}</p>
    </div>
    <div class="cta__actions">
      <Button href={localePath(locale, '/contact/')} variant="primary">{menu.call}</Button>
      <Button href={localePath(locale, '/contact/#message')} variant="secondary">{menu.message}</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
  }

  .cta__panel {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-40);
    padding: var(--space-120) clamp(24px, 5.29vw, 80px);
    overflow: hidden;
    border-radius: var(--radius-48);
    text-align: center;
  }


  .cta__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .cta__title {
    font-family: var(--font-display);
    font-weight: 600;
    /* 72 на макеті; з невеликим запасом, щоб заголовок лишався в один рядок попри смугу прокрутки */
    font-size: clamp(2rem, 4.6vw, 4.5rem);
    line-height: 120%;
  }

  .cta__lead {
    font-size: 1.5rem; /* 24px */
    line-height: 141.6667%; /* 34px */
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-16);
  }

  @media (max-width: 640px) {
    .cta {
      padding: var(--space-56) var(--space-20);
    }
    .cta__panel {
      gap: var(--space-32);
      padding: var(--space-64) var(--space-20);
      border-radius: var(--radius-24);
    }
    .cta__lead {
      font-size: var(--text-body-l);
      line-height: var(--text-body-l--line-height);
    }
    .cta__actions {
      flex-direction: column;
      align-self: stretch;
    }
    .cta__actions :global(.btn) {
      height: 50px;
    }
  }
</style>
