---
/**
 * Блок «09 Заклик до дії» (Figma «Головна · Варіант 2», темна й світла тема).
 * Панель із радіусом 48: розмита картинка рідини під кольором теми (складено з Figma в одну картинку),
 * заголовок 72, підпис 24 і дві кнопки по центру.
 * Панель проявляється під час прокрутки (спільний ефект [data-reveal-row], global.css і src/scripts/reveal-row.ts).
 */
import { Image } from 'astro:assets';
import Breath from './Breath.astro';
// Світла тема (макет): фон-градієнт 70 %, Normal, на орхідеї #dda3f7 — смуга з середини фото, повернута на 180°
import bgLight from '../assets/backgrounds/cta-light.jpg';
// Темна тема (макет): той самий темний градієнт 100 %, смуга 62–80 % висоти фото, поверх #150b2e 50 %
import bgDark from '../assets/backgrounds/cta-dark.jpg';
import Button from './Button.astro';
import { keepLastWords, localePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /**
   * Тексти для іншої сторінки (напр. «Заклик до дії» сторінки послуги); без них — тексти головної.
   * text — масив: кожен елемент з нового рядка (як у макеті). call і message — підписи кнопок.
   */
  content?: { title: string; text: string[]; call: string; message: string };
}

const { locale, content } = Astro.props;
const t = ui[locale].cta;
const menu = ui[locale].menu;
const lines = content ? content.text : [t.text];
---

<section class="cta" aria-labelledby="cta-title" data-reveal-row>
  <div class="cta__panel">
    <Breath variant="cta" lightImage={bgLight} darkImage={bgDark} />
    <div class="cta__text">
      <h2 class="cta__title" id="cta-title">{content?.title ?? t.title}</h2>
      <p class="cta__lead">{lines.map((line, i) => <>{i > 0 && <br />}{keepLastWords(line)}</>)}</p>
    </div>
    <div class="cta__actions">
      <Button href={localePath(locale, '/contact/')} variant="primary">{content?.call ?? menu.call}</Button>
      <Button href={localePath(locale, '/contact/#message')} variant="secondary">{content?.message ?? menu.message}</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: var(--space-120) var(--gutter);
    background: var(--section-bg);
  }

  .cta__panel {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-40);
    padding: var(--space-120) clamp(24px, 5.29vw, 80px);
    overflow: hidden;
    border-radius: var(--radius-48);
    text-align: center;
  }


  .cta__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .cta__title {
    font-family: var(--font-display);
    font-weight: 600;
    /* 72 на макеті; з невеликим запасом, щоб заголовок лишався в один рядок попри смугу прокрутки */
    font-size: clamp(2rem, 4.6vw, 4.5rem);
    line-height: 120%;
  }

  .cta__lead {
    font-size: 1.5rem; /* 24px */
    line-height: 141.6667%; /* 34px */
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-16);
  }

  /* Планшет: менший відступ від блоку FAQ над CTA (рішення Яни 23.11.2026); тільки коли CTA йде одразу після FAQ */
  @media (min-width: 641px) and (max-width: 1100px) {
    :global(.faq) + .cta {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .cta {
      padding: var(--space-56) var(--space-20);
    }
    .cta__panel {
      gap: var(--space-32);
      padding: var(--space-64) var(--space-20);
      border-radius: var(--radius-24);
    }
    .cta__lead {
      font-size: var(--text-body-l);
      line-height: var(--text-body-l--line-height);
    }
    .cta__actions {
      flex-direction: column;
      align-self: stretch;
    }
    .cta__actions :global(.btn) {
      height: 50px;
    }
  }
</style>

<script>
  // Панель «Заклику» проявляється, коли блок піднявся до 60 % висоти екрана
  import '../scripts/reveal-row';
</script>
